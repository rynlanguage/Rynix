// Built-in 5x7 bitmap font for ASCII. Each glyph is 7 rows of 5 bits; the high bit is the left column.
// Lowercase letters use the capital shapes. Codes outside 32..127 draw as a solid box.
// Text is drawn by graphics::Frame::draw_text as filled rectangles, so it needs no texture.

pub fun glyph_width() -> i32 => 5
pub fun glyph_height() -> i32 => 7
// Pixels from one glyph's left edge to the next, including one blank column of spacing.
pub fun advance() -> i32 => 6

// Glyph index for a character: code - 32, or the box glyph (index 95) when outside printable ASCII.
pub fun glyph_index(ch: char) -> u64 {
    code := ch as u32
    when code < 32 || code > 127 { return 95 }
    return (code - 32) as u64
}

// Width in pixels of text drawn at the given scale. The last glyph has no trailing spacing.
pub fun width(text: str, scale: i32) -> i32 {
    mut count: i32 = 0
    for ch in text { count += 1 }
    when count == 0 || scale <= 0 { return 0 }
    return count * advance() * scale - scale
}

// Seven row bytes per glyph, indexed by glyph_index(ch) * 7 + row. Bit 0x10 is the left column.
pub fun rows() -> [u8; 672] {
    return [
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // 32  
    0x04, 0x04, 0x04, 0x04, 0x04, 0x00, 0x04,  // 33 !
    0x0A, 0x0A, 0x0A, 0x00, 0x00, 0x00, 0x00,  // 34 "
    0x0A, 0x0A, 0x1F, 0x0A, 0x1F, 0x0A, 0x0A,  // 35 #
    0x04, 0x0F, 0x14, 0x0E, 0x05, 0x1E, 0x04,  // 36 $
    0x18, 0x19, 0x02, 0x04, 0x08, 0x13, 0x03,  // 37 %
    0x0C, 0x12, 0x14, 0x08, 0x15, 0x12, 0x0D,  // 38 &
    0x04, 0x04, 0x08, 0x00, 0x00, 0x00, 0x00,  // 39 '
    0x02, 0x04, 0x08, 0x08, 0x08, 0x04, 0x02,  // 40 (
    0x08, 0x04, 0x02, 0x02, 0x02, 0x04, 0x08,  // 41 )
    0x00, 0x04, 0x15, 0x0E, 0x15, 0x04, 0x00,  // 42 *
    0x00, 0x04, 0x04, 0x1F, 0x04, 0x04, 0x00,  // 43 +
    0x00, 0x00, 0x00, 0x00, 0x04, 0x04, 0x08,  // 44 ,
    0x00, 0x00, 0x00, 0x1F, 0x00, 0x00, 0x00,  // 45 -
    0x00, 0x00, 0x00, 0x00, 0x00, 0x0C, 0x0C,  // 46 .
    0x01, 0x02, 0x02, 0x04, 0x08, 0x08, 0x10,  // 47 /
    0x0E, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0E,  // 48 0
    0x04, 0x0C, 0x04, 0x04, 0x04, 0x04, 0x0E,  // 49 1
    0x0E, 0x11, 0x01, 0x02, 0x04, 0x08, 0x1F,  // 50 2
    0x1F, 0x02, 0x04, 0x02, 0x01, 0x11, 0x0E,  // 51 3
    0x02, 0x06, 0x0A, 0x12, 0x1F, 0x02, 0x02,  // 52 4
    0x1F, 0x10, 0x1E, 0x01, 0x01, 0x11, 0x0E,  // 53 5
    0x06, 0x08, 0x10, 0x1E, 0x11, 0x11, 0x0E,  // 54 6
    0x1F, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08,  // 55 7
    0x0E, 0x11, 0x11, 0x0E, 0x11, 0x11, 0x0E,  // 56 8
    0x0E, 0x11, 0x11, 0x0F, 0x01, 0x02, 0x0C,  // 57 9
    0x00, 0x0C, 0x0C, 0x00, 0x0C, 0x0C, 0x00,  // 58 :
    0x00, 0x0C, 0x0C, 0x00, 0x0C, 0x04, 0x08,  // 59 ;
    0x02, 0x04, 0x08, 0x10, 0x08, 0x04, 0x02,  // 60 <
    0x00, 0x00, 0x1F, 0x00, 0x1F, 0x00, 0x00,  // 61 =
    0x08, 0x04, 0x02, 0x01, 0x02, 0x04, 0x08,  // 62 >
    0x0E, 0x11, 0x01, 0x02, 0x04, 0x00, 0x04,  // 63 ?
    0x0E, 0x11, 0x01, 0x0D, 0x15, 0x15, 0x0E,  // 64 @
    0x0E, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11,  // 65 A
    0x1E, 0x11, 0x11, 0x1E, 0x11, 0x11, 0x1E,  // 66 B
    0x0E, 0x11, 0x10, 0x10, 0x10, 0x11, 0x0E,  // 67 C
    0x1C, 0x12, 0x11, 0x11, 0x11, 0x12, 0x1C,  // 68 D
    0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x1F,  // 69 E
    0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x10,  // 70 F
    0x0E, 0x11, 0x10, 0x17, 0x11, 0x11, 0x0F,  // 71 G
    0x11, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11,  // 72 H
    0x0E, 0x04, 0x04, 0x04, 0x04, 0x04, 0x0E,  // 73 I
    0x07, 0x02, 0x02, 0x02, 0x02, 0x12, 0x0C,  // 74 J
    0x11, 0x12, 0x14, 0x18, 0x14, 0x12, 0x11,  // 75 K
    0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x1F,  // 76 L
    0x11, 0x1B, 0x15, 0x15, 0x11, 0x11, 0x11,  // 77 M
    0x11, 0x11, 0x19, 0x15, 0x13, 0x11, 0x11,  // 78 N
    0x0E, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E,  // 79 O
    0x1E, 0x11, 0x11, 0x1E, 0x10, 0x10, 0x10,  // 80 P
    0x0E, 0x11, 0x11, 0x11, 0x15, 0x12, 0x0D,  // 81 Q
    0x1E, 0x11, 0x11, 0x1E, 0x14, 0x12, 0x11,  // 82 R
    0x0F, 0x10, 0x10, 0x0E, 0x01, 0x01, 0x1E,  // 83 S
    0x1F, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04,  // 84 T
    0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E,  // 85 U
    0x11, 0x11, 0x11, 0x11, 0x11, 0x0A, 0x04,  // 86 V
    0x11, 0x11, 0x11, 0x15, 0x15, 0x15, 0x0A,  // 87 W
    0x11, 0x11, 0x0A, 0x04, 0x0A, 0x11, 0x11,  // 88 X
    0x11, 0x11, 0x0A, 0x04, 0x04, 0x04, 0x04,  // 89 Y
    0x1F, 0x01, 0x02, 0x04, 0x08, 0x10, 0x1F,  // 90 Z
    0x0E, 0x08, 0x08, 0x08, 0x08, 0x08, 0x0E,  // 91 [
    0x10, 0x08, 0x08, 0x04, 0x02, 0x02, 0x01,  // 92 backslash
    0x0E, 0x02, 0x02, 0x02, 0x02, 0x02, 0x0E,  // 93 ]
    0x04, 0x0A, 0x11, 0x00, 0x00, 0x00, 0x00,  // 94 ^
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x1F,  // 95 _
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // 96 `
    0x0E, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11,  // 97 a
    0x1E, 0x11, 0x11, 0x1E, 0x11, 0x11, 0x1E,  // 98 b
    0x0E, 0x11, 0x10, 0x10, 0x10, 0x11, 0x0E,  // 99 c
    0x1C, 0x12, 0x11, 0x11, 0x11, 0x12, 0x1C,  // 100 d
    0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x1F,  // 101 e
    0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x10,  // 102 f
    0x0E, 0x11, 0x10, 0x17, 0x11, 0x11, 0x0F,  // 103 g
    0x11, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11,  // 104 h
    0x0E, 0x04, 0x04, 0x04, 0x04, 0x04, 0x0E,  // 105 i
    0x07, 0x02, 0x02, 0x02, 0x02, 0x12, 0x0C,  // 106 j
    0x11, 0x12, 0x14, 0x18, 0x14, 0x12, 0x11,  // 107 k
    0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x1F,  // 108 l
    0x11, 0x1B, 0x15, 0x15, 0x11, 0x11, 0x11,  // 109 m
    0x11, 0x11, 0x19, 0x15, 0x13, 0x11, 0x11,  // 110 n
    0x0E, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E,  // 111 o
    0x1E, 0x11, 0x11, 0x1E, 0x10, 0x10, 0x10,  // 112 p
    0x0E, 0x11, 0x11, 0x11, 0x15, 0x12, 0x0D,  // 113 q
    0x1E, 0x11, 0x11, 0x1E, 0x14, 0x12, 0x11,  // 114 r
    0x0F, 0x10, 0x10, 0x0E, 0x01, 0x01, 0x1E,  // 115 s
    0x1F, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04,  // 116 t
    0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E,  // 117 u
    0x11, 0x11, 0x11, 0x11, 0x11, 0x0A, 0x04,  // 118 v
    0x11, 0x11, 0x11, 0x15, 0x15, 0x15, 0x0A,  // 119 w
    0x11, 0x11, 0x0A, 0x04, 0x0A, 0x11, 0x11,  // 120 x
    0x11, 0x11, 0x0A, 0x04, 0x04, 0x04, 0x04,  // 121 y
    0x1F, 0x01, 0x02, 0x04, 0x08, 0x10, 0x1F,  // 122 z
    0x1F, 0x11, 0x11, 0x11, 0x11, 0x11, 0x1F,  // 123 {
    0x1F, 0x11, 0x11, 0x11, 0x11, 0x11, 0x1F,  // 124 |
    0x1F, 0x11, 0x11, 0x11, 0x11, 0x11, 0x1F,  // 125 }
    0x1F, 0x11, 0x11, 0x11, 0x11, 0x11, 0x1F,  // 126 ~
    0x1F, 0x11, 0x11, 0x11, 0x11, 0x11, 0x1F,  // 127 
    ]
}
