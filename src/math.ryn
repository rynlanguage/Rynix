use std::math

pub struct Vec2 {
    pub x: f32,
    pub y: f32,
}

extend Vec2 {
    pub fun new(x: f32, y: f32) -> Vec2 => Vec2 { x: x, y: y }
    pub fun dot(self, rhs: Vec2) -> f32 => self.x * rhs.x + self.y * rhs.y
    pub fun length_squared(self) -> f32 => self.x * self.x + self.y * self.y
    pub fun length(self) -> f32 => math::sqrt(self.length_squared() as f64) as f32

    pub fun add(self, rhs: Vec2) -> Vec2 => Vec2::new(self.x + rhs.x, self.y + rhs.y)
    pub fun sub(self, rhs: Vec2) -> Vec2 => Vec2::new(self.x - rhs.x, self.y - rhs.y)
    pub fun mul(self, scale: f32) -> Vec2 => Vec2::new(self.x * scale, self.y * scale)
    pub fun div(self, scale: f32) -> Vec2 => Vec2::new(self.x / scale, self.y / scale)
}

pub struct Vec3 {
    pub x: f32,
    pub y: f32,
    pub z: f32,
}

extend Vec3 {
    pub fun new(x: f32, y: f32, z: f32) -> Vec3 => Vec3 { x: x, y: y, z: z }
    pub fun dot(self, rhs: Vec3) -> f32 => self.x * rhs.x + self.y * rhs.y + self.z * rhs.z
    pub fun cross(self, rhs: Vec3) -> Vec3 => Vec3::new(
        self.y * rhs.z - self.z * rhs.y,
        self.z * rhs.x - self.x * rhs.z,
        self.x * rhs.y - self.y * rhs.x
    )
    pub fun length_squared(self) -> f32 => self.x * self.x + self.y * self.y + self.z * self.z
    pub fun length(self) -> f32 => math::sqrt(self.length_squared() as f64) as f32
    pub fun normalized(self) -> Vec3 => Vec3::new(self.x / self.length(), self.y / self.length(), self.z / self.length())

    pub fun add(self, rhs: Vec3) -> Vec3 => Vec3::new(self.x + rhs.x, self.y + rhs.y, self.z + rhs.z)
    pub fun sub(self, rhs: Vec3) -> Vec3 => Vec3::new(self.x - rhs.x, self.y - rhs.y, self.z - rhs.z)
    pub fun mul(self, scale: f32) -> Vec3 => Vec3::new(self.x * scale, self.y * scale, self.z * scale)
    pub fun div(self, scale: f32) -> Vec3 => Vec3::new(self.x / scale, self.y / scale, self.z / scale)
}

pub struct Vec4 {
    pub x: f32,
    pub y: f32,
    pub z: f32,
    pub w: f32,
}

extend Vec4 {
    pub fun new(x: f32, y: f32, z: f32, w: f32) -> Vec4 => Vec4 { x: x, y: y, z: z, w: w }
    pub fun dot(self, rhs: Vec4) -> f32 => self.x * rhs.x + self.y * rhs.y + self.z * rhs.z + self.w * rhs.w
    pub fun length_squared(self) -> f32 => self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w
    pub fun length(self) -> f32 => math::sqrt(self.length_squared() as f64) as f32

    pub fun add(self, rhs: Vec4) -> Vec4 => Vec4::new(self.x + rhs.x, self.y + rhs.y, self.z + rhs.z, self.w + rhs.w)
    pub fun sub(self, rhs: Vec4) -> Vec4 => Vec4::new(self.x - rhs.x, self.y - rhs.y, self.z - rhs.z, self.w - rhs.w)
    pub fun mul(self, scale: f32) -> Vec4 => Vec4::new(self.x * scale, self.y * scale, self.z * scale, self.w * scale)
    pub fun div(self, scale: f32) -> Vec4 => Vec4::new(self.x / scale, self.y / scale, self.z / scale, self.w / scale)
}

pub struct Color {
    pub r: u8,
    pub g: u8,
    pub b: u8,
    pub a: u8,
}

extend Color {
    pub fun rgb(r: u8, g: u8, b: u8) -> Color => Color { r: r, g: g, b: b, a: 255 }
    pub fun rgba(r: u8, g: u8, b: u8, a: u8) -> Color => Color { r: r, g: g, b: b, a: a }

    pub const BLACK: Color = Color { r: 0, g: 0, b: 0, a: 255 }
    pub const WHITE: Color = Color { r: 255, g: 255, b: 255, a: 255 }
    pub const RED: Color = Color { r: 230, g: 41, b: 55, a: 255 }
    pub const GREEN: Color = Color { r: 0, g: 228, b: 48, a: 255 }
    pub const BLUE: Color = Color { r: 0, g: 121, b: 241, a: 255 }
}
