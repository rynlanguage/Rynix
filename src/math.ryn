use std::math

pub fun pi() -> f32 => 3.14159265

pub fun radians(degrees: f32) -> f32 => degrees * pi() / (180.0 as f32)
pub fun degrees(radians: f32) -> f32 => radians * (180.0 as f32) / pi()
pub fun lerp(from: f32, to: f32, t: f32) -> f32 => from + (to - from) * t

pub struct Vec2 {
    pub x: f32,
    pub y: f32,
}

extend Vec2 {
    pub fun new(x: f32, y: f32) -> Vec2 => Vec2 { x: x, y: y }
    pub fun dot(self, rhs: Vec2) -> f32 => self.x * rhs.x + self.y * rhs.y
    pub fun length_squared(self) -> f32 => self.x * self.x + self.y * self.y
    pub fun length(self) -> f32 => math::sqrt(self.length_squared() as f64) as f32

    pub fun add(self, rhs: Vec2) -> Vec2 => Vec2::new(self.x + rhs.x, self.y + rhs.y)
    pub fun sub(self, rhs: Vec2) -> Vec2 => Vec2::new(self.x - rhs.x, self.y - rhs.y)
    pub fun mul(self, scale: f32) -> Vec2 => Vec2::new(self.x * scale, self.y * scale)
    pub fun div(self, scale: f32) -> Vec2 => Vec2::new(self.x / scale, self.y / scale)
    pub fun neg(self) -> Vec2 => Vec2::new(0.0 - self.x, 0.0 - self.y)

    pub fun normalized(self) -> Vec2 => self.div(self.length())
    pub fun distance(self, rhs: Vec2) -> f32 => self.sub(rhs).length()
    // t = 0 gives self, t = 1 gives rhs.
    pub fun lerp(self, rhs: Vec2, t: f32) -> Vec2 => Vec2::new(self.x + (rhs.x - self.x) * t, self.y + (rhs.y - self.y) * t)
}

pub struct Vec3 {
    pub x: f32,
    pub y: f32,
    pub z: f32,
}

extend Vec3 {
    pub fun new(x: f32, y: f32, z: f32) -> Vec3 => Vec3 { x: x, y: y, z: z }
    pub fun dot(self, rhs: Vec3) -> f32 => self.x * rhs.x + self.y * rhs.y + self.z * rhs.z
    pub fun cross(self, rhs: Vec3) -> Vec3 => Vec3::new(
        self.y * rhs.z - self.z * rhs.y,
        self.z * rhs.x - self.x * rhs.z,
        self.x * rhs.y - self.y * rhs.x
    )
    pub fun length_squared(self) -> f32 => self.x * self.x + self.y * self.y + self.z * self.z
    pub fun length(self) -> f32 => math::sqrt(self.length_squared() as f64) as f32
    pub fun normalized(self) -> Vec3 => Vec3::new(self.x / self.length(), self.y / self.length(), self.z / self.length())

    // Yaw turns around Y. Pitch rises from the horizontal plane. The result has length 1.
    pub fun from_angles(yaw: f32, pitch: f32) -> Vec3 {
        yaw_sin := math::sin(yaw as f64) as f32
        yaw_cos := math::cos(yaw as f64) as f32
        pitch_sin := math::sin(pitch as f64) as f32
        pitch_cos := math::cos(pitch as f64) as f32
        return Vec3::new(yaw_sin * pitch_cos, pitch_sin, yaw_cos * pitch_cos)
    }
    pub fun try_normalized(self) -> Option<Vec3> {
        length := self.length()
        when length == 0.0 {
            return Option::None
        }
        return Option::Some(Vec3::new(self.x / length, self.y / length, self.z / length))
    }

    pub fun add(self, rhs: Vec3) -> Vec3 => Vec3::new(self.x + rhs.x, self.y + rhs.y, self.z + rhs.z)
    pub fun sub(self, rhs: Vec3) -> Vec3 => Vec3::new(self.x - rhs.x, self.y - rhs.y, self.z - rhs.z)
    pub fun mul(self, scale: f32) -> Vec3 => Vec3::new(self.x * scale, self.y * scale, self.z * scale)
    pub fun div(self, scale: f32) -> Vec3 => Vec3::new(self.x / scale, self.y / scale, self.z / scale)
    pub fun neg(self) -> Vec3 => Vec3::new(0.0 - self.x, 0.0 - self.y, 0.0 - self.z)

    pub fun distance(self, rhs: Vec3) -> f32 => self.sub(rhs).length()
    // t = 0 gives self, t = 1 gives rhs.
    pub fun lerp(self, rhs: Vec3, t: f32) -> Vec3 => Vec3::new(
        self.x + (rhs.x - self.x) * t,
        self.y + (rhs.y - self.y) * t,
        self.z + (rhs.z - self.z) * t
    )

    pub const ZERO: Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    pub const ONE: Vec3 = Vec3 { x: 1.0, y: 1.0, z: 1.0 }
    pub const UP: Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 }
}

pub struct Vec4 {
    pub x: f32,
    pub y: f32,
    pub z: f32,
    pub w: f32,
}

extend Vec4 {
    pub fun new(x: f32, y: f32, z: f32, w: f32) -> Vec4 => Vec4 { x: x, y: y, z: z, w: w }
    pub fun dot(self, rhs: Vec4) -> f32 => self.x * rhs.x + self.y * rhs.y + self.z * rhs.z + self.w * rhs.w
    pub fun length_squared(self) -> f32 => self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w
    pub fun length(self) -> f32 => math::sqrt(self.length_squared() as f64) as f32

    pub fun add(self, rhs: Vec4) -> Vec4 => Vec4::new(self.x + rhs.x, self.y + rhs.y, self.z + rhs.z, self.w + rhs.w)
    pub fun sub(self, rhs: Vec4) -> Vec4 => Vec4::new(self.x - rhs.x, self.y - rhs.y, self.z - rhs.z, self.w - rhs.w)
    pub fun mul(self, scale: f32) -> Vec4 => Vec4::new(self.x * scale, self.y * scale, self.z * scale, self.w * scale)
    pub fun div(self, scale: f32) -> Vec4 => Vec4::new(self.x / scale, self.y / scale, self.z / scale, self.w / scale)
}

pub struct Color {
    pub r: u8,
    pub g: u8,
    pub b: u8,
    pub a: u8,
}

extend Color {
    pub fun rgb(r: u8, g: u8, b: u8) -> Color => Color { r: r, g: g, b: b, a: 255 }
    pub fun rgba(r: u8, g: u8, b: u8, a: u8) -> Color => Color { r: r, g: g, b: b, a: a }
    pub fun with_alpha(self, a: u8) -> Color => Color { r: self.r, g: self.g, b: self.b, a: a }

    pub const BLACK: Color = Color { r: 0, g: 0, b: 0, a: 255 }
    pub const WHITE: Color = Color { r: 255, g: 255, b: 255, a: 255 }
    pub const RED: Color = Color { r: 230, g: 41, b: 55, a: 255 }
    pub const GREEN: Color = Color { r: 0, g: 228, b: 48, a: 255 }
    pub const BLUE: Color = Color { r: 0, g: 121, b: 241, a: 255 }
    pub const YELLOW: Color = Color { r: 253, g: 249, b: 0, a: 255 }
    pub const ORANGE: Color = Color { r: 255, g: 161, b: 0, a: 255 }
    pub const PURPLE: Color = Color { r: 200, g: 122, b: 255, a: 255 }
    pub const SKY_BLUE: Color = Color { r: 102, g: 191, b: 255, a: 255 }
    pub const LIGHT_GRAY: Color = Color { r: 200, g: 200, b: 200, a: 255 }
    pub const GRAY: Color = Color { r: 130, g: 130, b: 130, a: 255 }
    pub const DARK_GRAY: Color = Color { r: 80, g: 80, b: 80, a: 255 }
    pub const BLANK: Color = Color { r: 0, g: 0, b: 0, a: 0 }
}

// Column-major 4x4. c0..c3 are the first column.
#[repr(C)]
pub struct Mat4 {
    pub c0: f32, pub c1: f32, pub c2: f32, pub c3: f32,
    pub c4: f32, pub c5: f32, pub c6: f32, pub c7: f32,
    pub c8: f32, pub c9: f32, pub c10: f32, pub c11: f32,
    pub c12: f32, pub c13: f32, pub c14: f32, pub c15: f32,
}

extend Mat4 {
    pub fun identity() -> Mat4 => Mat4 {
        c0: 1.0, c1: 0.0, c2: 0.0, c3: 0.0,
        c4: 0.0, c5: 1.0, c6: 0.0, c7: 0.0,
        c8: 0.0, c9: 0.0, c10: 1.0, c11: 0.0,
        c12: 0.0, c13: 0.0, c14: 0.0, c15: 1.0,
    }

    pub fun translation(x: f32, y: f32, z: f32) -> Mat4 => Mat4 {
        c0: 1.0, c1: 0.0, c2: 0.0, c3: 0.0,
        c4: 0.0, c5: 1.0, c6: 0.0, c7: 0.0,
        c8: 0.0, c9: 0.0, c10: 1.0, c11: 0.0,
        c12: x, c13: y, c14: z, c15: 1.0,
    }

    pub fun scale(x: f32, y: f32, z: f32) -> Mat4 => Mat4 {
        c0: x, c1: 0.0, c2: 0.0, c3: 0.0,
        c4: 0.0, c5: y, c6: 0.0, c7: 0.0,
        c8: 0.0, c9: 0.0, c10: z, c11: 0.0,
        c12: 0.0, c13: 0.0, c14: 0.0, c15: 1.0,
    }

    pub fun rotation_x(radians: f32) -> Mat4 {
        sine := math::sin(radians as f64) as f32
        cosine := math::cos(radians as f64) as f32
        return Mat4 {
            c0: 1.0, c1: 0.0, c2: 0.0, c3: 0.0,
            c4: 0.0, c5: cosine, c6: sine, c7: 0.0,
            c8: 0.0, c9: 0.0 - sine, c10: cosine, c11: 0.0,
            c12: 0.0, c13: 0.0, c14: 0.0, c15: 1.0,
        }
    }

    pub fun rotation_z(radians: f32) -> Mat4 {
        sine := math::sin(radians as f64) as f32
        cosine := math::cos(radians as f64) as f32
        return Mat4 {
            c0: cosine, c1: sine, c2: 0.0, c3: 0.0,
            c4: 0.0 - sine, c5: cosine, c6: 0.0, c7: 0.0,
            c8: 0.0, c9: 0.0, c10: 1.0, c11: 0.0,
            c12: 0.0, c13: 0.0, c14: 0.0, c15: 1.0,
        }
    }

    // Transforms a point (w = 1) and divides by w when w is not zero.
    pub fun transform_point(self, point: Vec3) -> Vec3 {
        x := self.c0 * point.x + self.c4 * point.y + self.c8 * point.z + self.c12
        y := self.c1 * point.x + self.c5 * point.y + self.c9 * point.z + self.c13
        z := self.c2 * point.x + self.c6 * point.y + self.c10 * point.z + self.c14
        w := self.c3 * point.x + self.c7 * point.y + self.c11 * point.z + self.c15
        when w == (0.0 as f32) || w == (1.0 as f32) { return Vec3::new(x, y, z) }
        return Vec3::new(x / w, y / w, z / w)
    }

    pub fun rotation_y(radians: f32) -> Mat4 {
        sine := math::sin(radians as f64) as f32
        cosine := math::cos(radians as f64) as f32
        return Mat4 {
            c0: cosine, c1: 0.0, c2: 0.0 - sine, c3: 0.0,
            c4: 0.0, c5: 1.0, c6: 0.0, c7: 0.0,
            c8: sine, c9: 0.0, c10: cosine, c11: 0.0,
            c12: 0.0, c13: 0.0, c14: 0.0, c15: 1.0,
        }
    }

    pub fun perspective(fov_degrees: f32, aspect: f32, near: f32, far: f32) -> Mat4 {
        when aspect == 0.0 || near == far { return Mat4::identity() }
        half := fov_degrees * (3.14159265 as f32) / (360.0 as f32)
        focal := (1.0 as f32) / (math::tan(half as f64) as f32)
        vertical := 0.0 - focal
        depth := far / (near - far)
        span := near * far / (near - far)
        return Mat4 {
            c0: focal / aspect, c1: 0.0, c2: 0.0, c3: 0.0,
            c4: 0.0, c5: vertical, c6: 0.0, c7: 0.0,
            c8: 0.0, c9: 0.0, c10: depth, c11: -1.0,
            c12: 0.0, c13: 0.0, c14: span, c15: 0.0,
        }
    }

    pub fun look_at(eye: Vec3, target: Vec3, up: Vec3) -> Mat4 {
        offset := target.sub(eye)
        when offset.length() == (0.0 as f32) { return Mat4::identity() }
        forward := offset.normalized()
        side_offset := forward.cross(up)
        when side_offset.length() == (0.0 as f32) { return Mat4::identity() }
        side := side_offset.normalized()
        cam_up := side.cross(forward)
        return Mat4 {
            c0: side.x, c1: cam_up.x, c2: 0.0 - forward.x, c3: 0.0,
            c4: side.y, c5: cam_up.y, c6: 0.0 - forward.y, c7: 0.0,
            c8: side.z, c9: cam_up.z, c10: 0.0 - forward.z, c11: 0.0,
            c12: 0.0 - side.dot(eye), c13: 0.0 - cam_up.dot(eye), c14: forward.dot(eye), c15: 1.0,
        }
    }

    pub fun mul(self, rhs: Mat4) -> Mat4 => Mat4 {
        c0: self.c0 * rhs.c0 + self.c4 * rhs.c1 + self.c8 * rhs.c2 + self.c12 * rhs.c3,
        c1: self.c1 * rhs.c0 + self.c5 * rhs.c1 + self.c9 * rhs.c2 + self.c13 * rhs.c3,
        c2: self.c2 * rhs.c0 + self.c6 * rhs.c1 + self.c10 * rhs.c2 + self.c14 * rhs.c3,
        c3: self.c3 * rhs.c0 + self.c7 * rhs.c1 + self.c11 * rhs.c2 + self.c15 * rhs.c3,
        c4: self.c0 * rhs.c4 + self.c4 * rhs.c5 + self.c8 * rhs.c6 + self.c12 * rhs.c7,
        c5: self.c1 * rhs.c4 + self.c5 * rhs.c5 + self.c9 * rhs.c6 + self.c13 * rhs.c7,
        c6: self.c2 * rhs.c4 + self.c6 * rhs.c5 + self.c10 * rhs.c6 + self.c14 * rhs.c7,
        c7: self.c3 * rhs.c4 + self.c7 * rhs.c5 + self.c11 * rhs.c6 + self.c15 * rhs.c7,
        c8: self.c0 * rhs.c8 + self.c4 * rhs.c9 + self.c8 * rhs.c10 + self.c12 * rhs.c11,
        c9: self.c1 * rhs.c8 + self.c5 * rhs.c9 + self.c9 * rhs.c10 + self.c13 * rhs.c11,
        c10: self.c2 * rhs.c8 + self.c6 * rhs.c9 + self.c10 * rhs.c10 + self.c14 * rhs.c11,
        c11: self.c3 * rhs.c8 + self.c7 * rhs.c9 + self.c11 * rhs.c10 + self.c15 * rhs.c11,
        c12: self.c0 * rhs.c12 + self.c4 * rhs.c13 + self.c8 * rhs.c14 + self.c12 * rhs.c15,
        c13: self.c1 * rhs.c12 + self.c5 * rhs.c13 + self.c9 * rhs.c14 + self.c13 * rhs.c15,
        c14: self.c2 * rhs.c12 + self.c6 * rhs.c13 + self.c10 * rhs.c14 + self.c14 * rhs.c15,
        c15: self.c3 * rhs.c12 + self.c7 * rhs.c13 + self.c11 * rhs.c14 + self.c15 * rhs.c15,
    }
}
