// Generated Vulkan names and shader words. The graphics module owns the device.
#[repr(C)]
pub struct VkText { bytes: [u8; 64] }

type VkGetProcFn = extern "C" fun(*u8, *u8) -> *u8

pub fun resolve(getter: *u8, object: *u8, text: VkText) -> *u8 {
    when pointer_is_null(getter) { return 0 as *u8 }
    lookup: VkGetProcFn = getter as VkGetProcFn
    mut name := text
    return lookup(object, (&raw name) as *u8)
}

