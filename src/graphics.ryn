type VkMemoryPropsFn = extern "C" fun(*u8, *VkMemoryProperties)
type VkAllocMemFn = extern "C" fun(*u8, *VkAllocInfo, *u8, *VkOut) -> i32
type VkBindImageFn = extern "C" fun(*u8, *u8, *u8, u64) -> i32

fun null_handle() -> *u8 { return 0 as *u8 }

fun created(result: i32, out: VkOut) -> *u8 {
    when result == 0 && !pointer_is_null(out.value) { return out.value }
    return null_handle()
}

fun pick4(index: u32, a: *u8, b: *u8, c: *u8, d: *u8) -> *u8 {
    when index == 0 { return a }
    when index == 1 { return b }
    when index == 2 { return c }
    when index == 3 { return d }
    return null_handle()
}

fun channel(value: u8) -> f32 { return (value as f32) / (255.0 as f32) }

fun empty_family() -> VkQueueFamily {
    return VkQueueFamily { flags: 0, count: 0, timestamps: 0, gx: 0, gy: 0, gz: 0 }
}

fun empty_format() -> VkFormatPair { return VkFormatPair { format: 0, space: 0 } }

fun empty_chosen() -> VkChosen {
    return VkChosen {
        physical: null_handle(),
        family: 0,
        format: 0,
        width: 0,
        height: 0,
        images: 0,
        alpha: 0,
        transform: 0,
        ok: 0,
        reason: 0,
    }
}

fun client_size(hwnd: *u8) -> VkExtent {
    mut size := VkExtent { w: 0, h: 0 }
    user32 := load_library("user32.dll")
    when pointer_is_null(user32) { return size }
    symbol := load_symbol(user32, "GetClientRect")
    when pointer_is_null(symbol) {
        unload_library(user32)
        return size
    }
    get_rect: VkClientRectFn = symbol as VkClientRectFn
    mut rect := VkClientRect { left: 0, top: 0, right: 0, bottom: 0 }
    get_rect(hwnd, &raw mut rect)
    unload_library(user32)
    when rect.right > rect.left { size.w = (rect.right - rect.left) as u32 }
    when rect.bottom > rect.top { size.h = (rect.bottom - rect.top) as u32 }
    return size
}

fun make_instance(getter: *u8) -> *u8 {
    create := vk_data::resolve(getter, null_handle(), vk_data::create_instance_name())
    when pointer_is_null(create) { return null_handle() }
    mut surface_name := vk_data::extension_surface_name()
    mut win32_name := vk_data::extension_win32_name()
    mut names := VkName2 { first: (&raw surface_name) as *u8, second: (&raw win32_name) as *u8 }
    mut app := VkApplication {
        s_type: 0,
        next: null_handle(),
        name: null_handle(),
        app_version: 0,
        engine: null_handle(),
        engine_version: 0,
        api_version: 4194304,
    }
    mut info := VkInstanceInfo {
        s_type: 1,
        next: null_handle(),
        flags: 0,
        app: (&raw app) as *u8,
        layer_count: 0,
        layers: null_handle(),
        ext_count: 2,
        exts: (&raw names) as *u8,
    }
    call: VkCreateInstanceFn = create as VkCreateInstanceFn
    mut out := VkOut { value: null_handle() }
    result := call(&raw mut info, null_handle(), &raw mut out)
    return created(result, out)
}

fun make_surface(getter: *u8, instance: *u8, hwnd: *u8) -> *u8 {
    create := vk_data::resolve(getter, instance, vk_data::create_win32_surface_name())
    when pointer_is_null(create) { return null_handle() }
    kernel := load_library("kernel32.dll")
    when pointer_is_null(kernel) { return null_handle() }
    symbol := load_symbol(kernel, "GetModuleHandleW")
    when pointer_is_null(symbol) {
        unload_library(kernel)
        return null_handle()
    }
    module_fn: VkModuleFn = symbol as VkModuleFn
    module := module_fn(null_handle())
    unload_library(kernel)
    when pointer_is_null(module) { return null_handle() }
    mut info := VkWin32Surface {
        s_type: 1000009000,
        next: null_handle(),
        flags: 0,
        instance: module,
        hwnd: hwnd,
    }
    call: VkCreateSurfaceFn = create as VkCreateSurfaceFn
    mut out := VkOut { value: null_handle() }
    result := call(instance, &raw mut info, null_handle(), &raw mut out)
    return created(result, out)
}

fun consider_device(
    families_fn: *u8,
    support_fn: *u8,
    caps_fn: *u8,
    formats_fn: *u8,
    surface: *u8,
    hwnd: *u8,
    physical: *u8
) -> VkChosen {
    mut chosen := empty_chosen()
    when pointer_is_null(physical) || pointer_is_null(families_fn) || pointer_is_null(support_fn) { return chosen }
    when pointer_is_null(caps_fn) || pointer_is_null(formats_fn) { return chosen }
    families: VkQueueFamiliesFn = families_fn as VkQueueFamiliesFn
    mut available: u32 = 0
    families(physical, &raw mut available, 0 as *VkFamilyList)
    when available == 0 {
        chosen.reason = 2
        return chosen
    }
    mut listed: u32 = available
    when listed > 8 { listed = 8 }
    mut list := VkFamilyList { items: [empty_family(); 8] }
    families(physical, &raw mut listed, &raw mut list)
    support: VkSurfaceSupportFn = support_fn as VkSurfaceSupportFn
    mut family_index: u32 = 0
    mut found_family: u32 = 0
    mut family: u32 = 0
    while family_index < listed {
        item := list.items[family_index]
        when (item.flags & 1) != 0 && item.count != 0 {
            mut supported: u32 = 0
            support_result := support(physical, family_index, surface, &raw mut supported)
            when support_result == 0 && supported != 0 {
                found_family = 1
                family = family_index
                break
            }
        }
        family_index += 1
    }
    when found_family == 0 {
        chosen.reason = 2
        return chosen
    }
    formats: VkSurfaceFormatsFn = formats_fn as VkSurfaceFormatsFn
    mut format_count: u32 = 0
    count_result := formats(physical, surface, &raw mut format_count, 0 as *VkFormatList)
    when count_result != 0 || format_count == 0 {
        chosen.reason = 3
        return chosen
    }
    mut format_listed: u32 = format_count
    when format_listed > 16 { format_listed = 16 }
    mut format_list := VkFormatList { items: [empty_format(); 16] }
    list_result := formats(physical, surface, &raw mut format_listed, &raw mut format_list)
    when list_result != 0 && list_result != 5 {
        chosen.reason = 3
        return chosen
    }
    mut best: u32 = 0
    mut format_index: u32 = 0
    while format_index < format_listed {
        pair := format_list.items[format_index]
        when pair.space == 0 && pair.format == 37 && best == 0 { best = 37 }
        when pair.space == 0 && pair.format == 44 { best = 44 }
        format_index += 1
    }
    when best == 0 {
        chosen.reason = 3
        return chosen
    }
    caps_call: VkSurfaceCapsFn = caps_fn as VkSurfaceCapsFn
    mut caps := VkSurfaceCaps {
        min_images: 0,
        max_images: 0,
        current_w: 0,
        current_h: 0,
        min_w: 0,
        min_h: 0,
        max_w: 0,
        max_h: 0,
        layers: 0,
        transforms: 0,
        current_transform: 0,
        alpha: 0,
        usage: 0,
    }
    caps_result := caps_call(physical, surface, &raw mut caps)
    when caps_result != 0 {
        chosen.reason = 4
        return chosen
    }
    when (caps.usage & 16) == 0 {
        chosen.reason = 5
        return chosen
    }
    mut width: u32 = caps.current_w
    mut height: u32 = caps.current_h
    when width == 4294967295 || height == 4294967295 {
        size := client_size(hwnd)
        width = size.w
        height = size.h
    }
    when width < caps.min_w { width = caps.min_w }
    when height < caps.min_h { height = caps.min_h }
    when caps.max_w != 0 && width > caps.max_w { width = caps.max_w }
    when caps.max_h != 0 && height > caps.max_h { height = caps.max_h }
    when width == 0 || height == 0 {
        chosen.reason = 6
        return chosen
    }
    when caps.min_images > 4 {
        chosen.reason = 7
        return chosen
    }
    mut images: u32 = caps.min_images
    when images < 2 { images = 2 }
    when images > 4 { images = 4 }
    when caps.max_images != 0 && images > caps.max_images {
        chosen.reason = 7
        return chosen
    }
    mut alpha: u32 = 0
    when (caps.alpha & 1) != 0 { alpha = 1 }
    else when (caps.alpha & 2) != 0 { alpha = 2 }
    else when (caps.alpha & 4) != 0 { alpha = 4 }
    else when (caps.alpha & 8) != 0 { alpha = 8 }
    when alpha == 0 {
        chosen.reason = 8
        return chosen
    }
    mut transform: u32 = caps.current_transform
    when transform == 0 { transform = 1 }
    return VkChosen {
        physical: physical,
        family: family,
        format: best,
        width: width,
        height: height,
        images: images,
        alpha: alpha,
        transform: transform,
        ok: 1,
        reason: 0,
    }
}

fun choose_device(getter: *u8, instance: *u8, surface: *u8, hwnd: *u8) -> VkChosen {
    mut chosen := empty_chosen()
    enumerate := vk_data::resolve(getter, instance, vk_data::enumerate_devices_name())
    families_fn := vk_data::resolve(getter, instance, vk_data::queue_families_name())
    support_fn := vk_data::resolve(getter, instance, vk_data::surface_support_name())
    caps_fn := vk_data::resolve(getter, instance, vk_data::surface_caps_name())
    formats_fn := vk_data::resolve(getter, instance, vk_data::surface_formats_name())
    when pointer_is_null(enumerate) {
        chosen.reason = 1
        return chosen
    }
    list_devices: VkEnumDevicesFn = enumerate as VkEnumDevicesFn
    mut available: u32 = 0
    count_result := list_devices(instance, &raw mut available, 0 as *VkHandles4)
    when count_result != 0 || available == 0 {
        chosen.reason = 1
        return chosen
    }
    mut listed: u32 = available
    when listed > 4 { listed = 4 }
    mut devices := VkHandles4 { a: null_handle(), b: null_handle(), c: null_handle(), d: null_handle() }
    list_result := list_devices(instance, &raw mut listed, &raw mut devices)
    when list_result != 0 && list_result != 5 {
        chosen.reason = 1
        return chosen
    }
    mut index: u32 = 0
    while index < listed {
        physical := pick4(index, devices.a, devices.b, devices.c, devices.d)
        chosen = consider_device(families_fn, support_fn, caps_fn, formats_fn, surface, hwnd, physical)
        when chosen.ok != 0 { return chosen }
        index += 1
    }
    when chosen.reason == 0 { chosen.reason = 2 }
    return chosen
}

fun make_device(getter: *u8, instance: *u8, physical: *u8, family: u32) -> *u8 {
    create := vk_data::resolve(getter, instance, vk_data::create_device_name())
    when pointer_is_null(create) { return null_handle() }
    mut priority: f32 = 1.0
    mut queue := VkDeviceQueue {
        s_type: 2,
        next: null_handle(),
        flags: 0,
        family: family,
        count: 1,
        priorities: (&raw priority) as *u8,
    }
    mut extension := vk_data::extension_swapchain_name()
    mut names := VkOnePtr { value: (&raw extension) as *u8 }
    mut info := VkDeviceInfo {
        s_type: 3,
        next: null_handle(),
        flags: 0,
        queue_count: 1,
        queues: (&raw queue) as *u8,
        layer_count: 0,
        layers: null_handle(),
        ext_count: 1,
        exts: (&raw names) as *u8,
        features: null_handle(),
    }
    call: VkCreateDeviceFn = create as VkCreateDeviceFn
    mut out := VkOut { value: null_handle() }
    result := call(physical, &raw mut info, null_handle(), &raw mut out)
    return created(result, out)
}

fun take_queue(get_queue: *u8, device: *u8, family: u32) -> *u8 {
    when pointer_is_null(get_queue) { return null_handle() }
    call: VkGetQueueFn = get_queue as VkGetQueueFn
    mut out := VkOut { value: null_handle() }
    call(device, family, 0, &raw mut out)
    return out.value
}

fun make_view(device: *u8, create: *u8, image: *u8, format: u32, aspect: u32) -> *u8 {
    when pointer_is_null(create) || pointer_is_null(image) { return null_handle() }
    mut info := VkImageViewInfo {
        s_type: 15,
        next: null_handle(),
        flags: 0,
        image: image,
        view_type: 1,
        format: format,
        r: 0,
        g: 0,
        b: 0,
        a: 0,
        aspect: aspect,
        base_mip: 0,
        mip_count: 1,
        base_layer: 0,
        layer_count: 1,
    }
    call: VkCreateViewFn = create as VkCreateViewFn
    mut out := VkOut { value: null_handle() }
    result := call(device, &raw mut info, null_handle(), &raw mut out)
    return created(result, out)
}

fun make_swapchain(device: *u8, create: *u8, images_fn: *u8, view_fn: *u8, surface: *u8, chosen: VkChosen) -> VkChain {
    mut chain := VkChain {
        swapchain: null_handle(),
        view0: null_handle(),
        view1: null_handle(),
        view2: null_handle(),
        view3: null_handle(),
        count: 0,
    }
    when pointer_is_null(create) || pointer_is_null(images_fn) || pointer_is_null(view_fn) { return chain }
    mut info := VkSwapchainInfo {
        s_type: 1000001000,
        next: null_handle(),
        flags: 0,
        surface: surface,
        min_images: chosen.images,
        format: chosen.format,
        space: 0,
        width: chosen.width,
        height: chosen.height,
        layers: 1,
        usage: 16,
        sharing: 0,
        family_count: 0,
        families: null_handle(),
        transform: chosen.transform,
        alpha: chosen.alpha,
        present: 2,
        clipped: 1,
        old: null_handle(),
    }
    call: VkCreateSwapchainFn = create as VkCreateSwapchainFn
    mut out := VkOut { value: null_handle() }
    result := call(device, &raw mut info, null_handle(), &raw mut out)
    chain.swapchain = created(result, out)
    when pointer_is_null(chain.swapchain) { return chain }
    list_images: VkSwapchainImagesFn = images_fn as VkSwapchainImagesFn
    mut available: u32 = 0
    count_result := list_images(device, chain.swapchain, &raw mut available, 0 as *VkHandles4)
    when count_result != 0 || available == 0 || available > 4 { return chain }
    mut listed: u32 = available
    mut images := VkHandles4 { a: null_handle(), b: null_handle(), c: null_handle(), d: null_handle() }
    list_result := list_images(device, chain.swapchain, &raw mut listed, &raw mut images)
    when list_result != 0 && list_result != 5 { return chain }
    chain.count = listed
    chain.view0 = make_view(device, view_fn, images.a, chosen.format, 1)
    when listed > 1 { chain.view1 = make_view(device, view_fn, images.b, chosen.format, 1) }
    when listed > 2 { chain.view2 = make_view(device, view_fn, images.c, chosen.format, 1) }
    when listed > 3 { chain.view3 = make_view(device, view_fn, images.d, chosen.format, 1) }
    return chain
}

fun empty_depth() -> VkDepth {
    return VkDepth { image: null_handle(), memory: null_handle(), view: null_handle(), format: 0 }
}

fun attempt_depth(get_instance: *u8, instance: *u8, get_device: *u8, device: *u8, physical: *u8, width: u32, height: u32, format: u32) -> VkDepth {
    create_image := vk_data::resolve(get_device, device, vk_data::create_image_name())
    destroy_image := vk_data::resolve(get_device, device, vk_data::destroy_image_name())
    requirements := vk_data::resolve(get_device, device, vk_data::image_memory_requirements_name())
    allocate := vk_data::resolve(get_device, device, vk_data::allocate_memory_name())
    free_memory := vk_data::resolve(get_device, device, vk_data::free_memory_name())
    bind_image := vk_data::resolve(get_device, device, vk_data::bind_image_memory_name())
    create_view := vk_data::resolve(get_device, device, vk_data::create_image_view_name())
    when pointer_is_null(create_image) || pointer_is_null(requirements) || pointer_is_null(allocate) { return empty_depth() }
    when pointer_is_null(bind_image) || pointer_is_null(create_view) { return empty_depth() }
    mut info := VkImageInfo {
        s_type: 14,
        next: null_handle(),
        flags: 0,
        image_type: 1,
        format: format,
        width: width,
        height: height,
        depth: 1,
        mips: 1,
        layers: 1,
        samples: 1,
        tiling: 0,
        usage: 32,
        sharing: 0,
        family_count: 0,
        families: null_handle(),
        initial: 0,
    }
    create_call: VkCreateImageFn = create_image as VkCreateImageFn
    mut image_out := VkOut { value: null_handle() }
    image_result := create_call(device, &raw mut info, null_handle(), &raw mut image_out)
    image := created(image_result, image_out)
    when pointer_is_null(image) { return empty_depth() }
    mut reqs := VkMemoryRequirements { size: 0, alignment: 0, type_bits: 0 }
    reqs_fn: VkImageReqsFn = requirements as VkImageReqsFn
    reqs_fn(device, image, &raw mut reqs)
    when reqs.size == (0 as u64) {
        destroy_child(destroy_image, device, image)
        return empty_depth()
    }
    mut chosen: u32 = 4294967295
    mut index: u32 = 0
    while index < (32 as u32) {
        bit := (1 as u32) << index
        when (reqs.type_bits & bit) != (0 as u32) && chosen == (4294967295 as u32) { chosen = index }
        index = index + (1 as u32)
    }
    when chosen == (4294967295 as u32) {
        destroy_child(destroy_image, device, image)
        return empty_depth()
    }
    mut alloc_info := VkAllocInfo { s_type: 5, next: null_handle(), allocation_size: reqs.size, memory_type: chosen }
    alloc_call: VkAllocMemFn = allocate as VkAllocMemFn
    mut memory_out := VkOut { value: null_handle() }
    memory_result := alloc_call(device, &raw mut alloc_info, null_handle(), &raw mut memory_out)
    memory := created(memory_result, memory_out)
    when pointer_is_null(memory) {
        destroy_child(destroy_image, device, image)
        return empty_depth()
    }
    bind_call: VkBindImageFn = bind_image as VkBindImageFn
    bind_result := bind_call(device, image, memory, 0 as u64)
    when bind_result != (0 as i32) {
        destroy_child(free_memory, device, memory)
        destroy_child(destroy_image, device, image)
        return empty_depth()
    }
    view := make_view(device, create_view, image, format, 2)
    when pointer_is_null(view) {
        destroy_child(free_memory, device, memory)
        destroy_child(destroy_image, device, image)
        return empty_depth()
    }
    return VkDepth { image: image, memory: memory, view: view, format: format }
}

fun make_depth(get_instance: *u8, instance: *u8, get_device: *u8, device: *u8, physical: *u8, width: u32, height: u32) -> VkDepth {
    first := attempt_depth(get_instance, instance, get_device, device, physical, width, height, 126)
    when !pointer_is_null(first.view) { return first }
    second := attempt_depth(get_instance, instance, get_device, device, physical, width, height, 129)
    when !pointer_is_null(second.view) { return second }
    return attempt_depth(get_instance, instance, get_device, device, physical, width, height, 124)
}

fun make_pass(device: *u8, create: *u8, format: u32, depth_format: u32) -> *u8 {
    when pointer_is_null(create) { return null_handle() }
    mut attachments := VkAttachmentPair {
        color: VkAttachment {
            flags: 0,
            format: format,
            samples: 1,
            load: 1,
            store: 0,
            stencil_load: 2,
            stencil_store: 1,
            initial: 0,
            final_layout: 1000001002,
        },
        depth: VkAttachment {
            flags: 0,
            format: depth_format,
            samples: 1,
            load: 1,
            store: 1,
            stencil_load: 2,
            stencil_store: 1,
            initial: 0,
            final_layout: 3,
        },
    }
    mut color_ref := VkAttachmentRef { attachment: 0, layout: 2 }
    mut depth_ref := VkAttachmentRef { attachment: 1, layout: 3 }
    mut subpass := VkSubpass {
        flags: 0,
        bind: 0,
        input_count: 0,
        inputs: null_handle(),
        color_count: 1,
        colors: (&raw color_ref) as *u8,
        resolve: null_handle(),
        depth: (&raw depth_ref) as *u8,
        preserve_count: 0,
        preserve: null_handle(),
    }
    mut dependencies := VkDependencyPair {
        first: VkDependency {
            src: 4294967295,
            dst: 0,
            src_stage: 1792,
            dst_stage: 1792,
            src_access: 0,
            dst_access: 1280,
            flags: 0,
        },
        second: VkDependency {
            src: 0,
            dst: 4294967295,
            src_stage: 1792,
            dst_stage: 1792,
            src_access: 1280,
            dst_access: 0,
            flags: 0,
        },
    }
    mut info := VkPassInfo {
        s_type: 38,
        next: null_handle(),
        flags: 0,
        attachment_count: 2,
        attachments: (&raw attachments) as *u8,
        subpass_count: 1,
        subpasses: (&raw subpass) as *u8,
        dependency_count: 2,
        dependencies: (&raw dependencies) as *u8,
    }
    call: VkCreatePassFn = create as VkCreatePassFn
    mut out := VkOut { value: null_handle() }
    result := call(device, &raw mut info, null_handle(), &raw mut out)
    return created(result, out)
}

fun make_framebuffer(device: *u8, create: *u8, pass: *u8, view: *u8, depth: *u8, width: u32, height: u32) -> *u8 {
    when pointer_is_null(create) || pointer_is_null(view) || pointer_is_null(depth) { return null_handle() }
    mut attachment := VkView2 { color: view, depth: depth }
    mut info := VkFramebufferInfo {
        s_type: 37,
        next: null_handle(),
        flags: 0,
        pass: pass,
        attachment_count: 2,
        attachments: (&raw attachment) as *u8,
        width: width,
        height: height,
        layers: 1,
    }
    call: VkCreateFbFn = create as VkCreateFbFn
    mut out := VkOut { value: null_handle() }
    result := call(device, &raw mut info, null_handle(), &raw mut out)
    return created(result, out)
}

