fun make_pipeline(device: *u8, layout_fn: *u8, pipeline_fn: *u8, pass: *u8, vertex: *u8, fragment: *u8, depth_test: u32, depth_write: u32, depth_compare: u32, push_size: u32, set_layout: *u8) -> VkPipelineBundle {
    mut bundle := VkPipelineBundle { pipeline: null_handle(), layout: null_handle() }
    when pointer_is_null(layout_fn) || pointer_is_null(pipeline_fn) { return bundle }
    mut entry := vk_data::entry_main_name()
    entry_name := (&raw entry) as *u8
    mut stages := VkStagePair {
        vertex: VkStageInfo {
            s_type: 18,
            next: null_handle(),
            flags: 0,
            stage: 1,
            module: vertex,
            name: entry_name,
            spec: null_handle(),
        },
        fragment: VkStageInfo {
            s_type: 18,
            next: null_handle(),
            flags: 0,
            stage: 16,
            module: fragment,
            name: entry_name,
            spec: null_handle(),
        },
    }
    mut vertex_info := VkVertexInfo {
        s_type: 19,
        next: null_handle(),
        flags: 0,
        binding_count: 0,
        bindings: null_handle(),
        attribute_count: 0,
        attributes: null_handle(),
    }
    mut binding := VkVertexBinding { binding: 0, stride: 32, rate: 0 }
    mut attributes := VkAttributes {
        position: VkAttribute { location: 0, binding: 0, format: 106, offset: 0 },
        normal: VkAttribute { location: 1, binding: 0, format: 106, offset: 12 },
        uv: VkAttribute { location: 2, binding: 0, format: 103, offset: 24 },
    }
    when push_size == 128 {
        vertex_info.binding_count = 1 vertex_info.bindings = (&raw binding) as *u8
        vertex_info.attribute_count = 3 vertex_info.attributes = (&raw attributes) as *u8
    }
    mut assembly := VkAssemblyInfo { s_type: 20, next: null_handle(), flags: 0, topology: 3, restart: 0 }
    mut viewport_state := VkViewportInfo {
        s_type: 22,
        next: null_handle(),
        flags: 0,
        viewport_count: 1,
        viewports: null_handle(),
        scissor_count: 1,
        scissors: null_handle(),
    }
    mut raster := VkRasterInfo {
        s_type: 23,
        next: null_handle(),
        flags: 0,
        depth_clamp: 0,
        discard: 0,
        polygon: 0,
        cull: 0,
        front: 0,
        bias_enable: 0,
        bias_const: 0.0,
        bias_clamp: 0.0,
        bias_slope: 0.0,
        line_width: 1.0,
    }
    when push_size == 128 { raster.cull = 2 raster.front = 0 }
    mut multi := VkSampleInfo {
        s_type: 24,
        next: null_handle(),
        flags: 0,
        samples: 1,
        shading: 0,
        min_shading: 0.0,
        mask: null_handle(),
        alpha_to_coverage: 0,
        alpha_to_one: 0,
    }
    mut blend_attachment := VkBlendAttachment {
        enable: 0,
        src_color: 0,
        dst_color: 0,
        color_op: 0,
        src_alpha: 0,
        dst_alpha: 0,
        alpha_op: 0,
        mask: 15,
    }
    mut blend := VkBlendInfo {
        s_type: 26,
        next: null_handle(),
        flags: 0,
        logic_enable: 0,
        logic: 0,
        attachment_count: 1,
        attachments: (&raw blend_attachment) as *u8,
        c0: 0.0,
        c1: 0.0,
        c2: 0.0,
        c3: 0.0,
    }
    mut dynamic_states := VkDynamicPair { viewport: 0, scissor: 1 }
    mut dynamic := VkDynamicInfo {
        s_type: 27,
        next: null_handle(),
        flags: 0,
        count: 2,
        states: (&raw dynamic_states) as *u8,
    }
    mut depth_state := VkDepthInfo {
        s_type: 25,
        next: null_handle(),
        flags: 0,
        test: depth_test,
        write: depth_write,
        compare: depth_compare,
        bounds_test: 0,
        stencil_test: 0,
        front: VkStencilOp { fail: 0, pass: 0, depth_fail: 0, compare: 0, compare_mask: 0, write_mask: 0, reference: 0 },
        back: VkStencilOp { fail: 0, pass: 0, depth_fail: 0, compare: 0, compare_mask: 0, write_mask: 0, reference: 0 },
        min_bounds: 0.0,
        max_bounds: 1.0,
    }
    mut push_range := VkPushRange { stages: 17, offset: 0, size: push_size }
    mut layout_info := VkLayoutInfo {
        s_type: 30,
        next: null_handle(),
        flags: 0,
        set_count: 0,
        sets: null_handle(),
        push_count: 1,
        push: (&raw push_range) as *u8,
    }
    mut descriptor_layout := set_layout
    when !pointer_is_null(set_layout) { layout_info.set_count = 1 layout_info.sets = (&raw descriptor_layout) as *u8 }
    layout_call: VkCreateLayoutFn = layout_fn as VkCreateLayoutFn
    mut layout_out := VkOut { value: null_handle() }
    layout_result := layout_call(device, &raw mut layout_info, null_handle(), &raw mut layout_out)
    bundle.layout = created(layout_result, layout_out)
    when pointer_is_null(bundle.layout) { return bundle }
    mut pipe := VkPipelineInfo {
        s_type: 28,
        next: null_handle(),
        flags: 0,
        stage_count: 2,
        stages: (&raw stages) as *u8,
        vertex: (&raw vertex_info) as *u8,
        assembly: (&raw assembly) as *u8,
        tessellation: null_handle(),
        viewport: (&raw viewport_state) as *u8,
        raster: (&raw raster) as *u8,
        multi: (&raw multi) as *u8,
        depth: (&raw depth_state) as *u8,
        blend: (&raw blend) as *u8,
        dynamic: (&raw dynamic) as *u8,
        layout: bundle.layout,
        pass: pass,
        subpass: 0,
        base: null_handle(),
        base_index: -1,
    }
    pipeline_call: VkCreatePipelinesFn = pipeline_fn as VkCreatePipelinesFn
    mut pipe_out := VkOut { value: null_handle() }
    pipe_result := pipeline_call(device, null_handle(), 1, &raw mut pipe, null_handle(), &raw mut pipe_out)
    bundle.pipeline = created(pipe_result, pipe_out)
    return bundle
}

fun make_commands(device: *u8, pool_fn: *u8, alloc_fn: *u8, family: u32) -> VkOnePtr {
    mut holder := VkOnePtr { value: null_handle() }
    when pointer_is_null(pool_fn) || pointer_is_null(alloc_fn) { return holder }
    mut pool_info := VkPoolInfo { s_type: 39, next: null_handle(), flags: 2, family: family }
    pool_call: VkCreatePoolFn = pool_fn as VkCreatePoolFn
    mut pool_out := VkOut { value: null_handle() }
    pool_result := pool_call(device, &raw mut pool_info, null_handle(), &raw mut pool_out)
    holder.value = created(pool_result, pool_out)
    return holder
}

fun allocate_command(device: *u8, alloc_fn: *u8, pool: *u8) -> *u8 {
    when pointer_is_null(alloc_fn) || pointer_is_null(pool) { return null_handle() }
    mut info := VkCommandAlloc { s_type: 40, next: null_handle(), pool: pool, level: 0, count: 1 }
    call: VkAllocCmdFn = alloc_fn as VkAllocCmdFn
    mut out := VkOut { value: null_handle() }
    result := call(device, &raw mut info, &raw mut out)
    return created(result, out)
}

fun make_semaphore(device: *u8, create: *u8) -> *u8 {
    when pointer_is_null(create) { return null_handle() }
    mut info := VkSemaphoreInfo { s_type: 9, next: null_handle(), flags: 0 }
    call: VkCreateSemFn = create as VkCreateSemFn
    mut out := VkOut { value: null_handle() }
    result := call(device, &raw mut info, null_handle(), &raw mut out)
    return created(result, out)
}

fun load_frame_procs(getter: *u8, device: *u8) -> VkFrameProcs {
    return VkFrameProcs {
        acquire: vk_data::resolve(getter, device, vk_data::acquire_name()),
        reset_command: vk_data::resolve(getter, device, vk_data::reset_command_name()),
        begin_command: vk_data::resolve(getter, device, vk_data::begin_command_name()),
        end_command: vk_data::resolve(getter, device, vk_data::end_command_name()),
        begin_pass: vk_data::resolve(getter, device, vk_data::begin_render_pass_name()),
        end_pass: vk_data::resolve(getter, device, vk_data::end_render_pass_name()),
        bind_pipeline: vk_data::resolve(getter, device, vk_data::bind_pipeline_name()),
        set_viewport: vk_data::resolve(getter, device, vk_data::set_viewport_name()),
        set_scissor: vk_data::resolve(getter, device, vk_data::set_scissor_name()),
        push_constants: vk_data::resolve(getter, device, vk_data::push_constants_name()),
        draw_cmd: vk_data::resolve(getter, device, vk_data::draw_name()),
        submit: vk_data::resolve(getter, device, vk_data::queue_submit_name()),
        present: vk_data::resolve(getter, device, vk_data::queue_present_name()),
        queue_wait: vk_data::resolve(getter, device, vk_data::queue_wait_name()),
        device_wait: vk_data::resolve(getter, device, vk_data::device_wait_name()),
    }
}

fun procs_ready(procs: VkFrameProcs) -> bool {
    when pointer_is_null(procs.acquire) || pointer_is_null(procs.reset_command) || pointer_is_null(procs.begin_command) { return false }
    when pointer_is_null(procs.end_command) || pointer_is_null(procs.begin_pass) || pointer_is_null(procs.end_pass) { return false }
    when pointer_is_null(procs.bind_pipeline) || pointer_is_null(procs.set_viewport) || pointer_is_null(procs.set_scissor) { return false }
    when pointer_is_null(procs.push_constants) || pointer_is_null(procs.draw_cmd) || pointer_is_null(procs.submit) { return false }
    when pointer_is_null(procs.present) || pointer_is_null(procs.queue_wait) || pointer_is_null(procs.device_wait) { return false }
    return true
}

fun resolve_device_fn(get_device: *u8, device: *u8, get_instance: *u8, instance: *u8, text: VkText) -> *u8 {
    when !pointer_is_null(get_device) && !pointer_is_null(device) {
        return vk_data::resolve(get_device, device, text)
    }
    when !pointer_is_null(get_instance) && !pointer_is_null(instance) {
        return vk_data::resolve(get_instance, instance, text)
    }
    return null_handle()
}

fun destroy_child(function: *u8, parent: *u8, child: *u8) {
    when pointer_is_null(function) || pointer_is_null(parent) || pointer_is_null(child) { return }
    destroy: VkDestroyChildFn = function as VkDestroyChildFn
    destroy(parent, child, null_handle())
}

fun submit_present(
    queue: *u8,
    command: *u8,
    command_count: u32,
    image_available: *u8,
    render_finished: *u8,
    swapchain: *u8,
    image_index: u32,
    submit_fn: *u8,
    present_fn: *u8,
    wait_fn: *u8
) {
    when pointer_is_null(submit_fn) || pointer_is_null(queue) { return }
    mut wait := VkOnePtr { value: image_available }
    mut signal := VkOnePtr { value: render_finished }
    mut cmd := VkOnePtr { value: command }
    mut stage: u32 = 1024
    mut info := VkSubmitInfo {
        s_type: 4,
        next: null_handle(),
        wait_count: 1,
        waits: (&raw wait) as *u8,
        stages: (&raw stage) as *u8,
        cmd_count: command_count,
        cmds: (&raw cmd) as *u8,
        signal_count: 1,
        signals: (&raw signal) as *u8,
    }
    submit: VkSubmitFn = submit_fn as VkSubmitFn
    submit(queue, 1, &raw mut info, null_handle())
    when !pointer_is_null(present_fn) && !pointer_is_null(swapchain) {
        mut chain := VkOnePtr { value: swapchain }
        mut present_wait := VkOnePtr { value: render_finished }
        mut index: u32 = image_index
        mut present_info := VkPresentInfo {
            s_type: 1000001001,
            next: null_handle(),
            wait_count: 1,
            waits: (&raw present_wait) as *u8,
            swapchain_count: 1,
            swapchains: (&raw chain) as *u8,
            indices: (&raw index) as *u8,
            results: null_handle(),
        }
        present: VkPresentFn = present_fn as VkPresentFn
        present(queue, &raw mut present_info)
    }
    when !pointer_is_null(wait_fn) {
        queue_idle: VkQueueWaitFn = wait_fn as VkQueueWaitFn
        queue_idle(queue)
    }
}

#[drop(drop_gpu)]
pub struct Gpu {
    library: *u8,
    resources: *mesh_backend::Context,
    get_instance: *u8,
    get_device: *u8,
    instance: *u8,
    surface: *u8,
    physical: *u8,
    device: *u8,
    queue: *u8,
    swapchain: *u8,
    view0: *u8,
    view1: *u8,
    view2: *u8,
    view3: *u8,
    fb0: *u8,
    fb1: *u8,
    fb2: *u8,
    fb3: *u8,
    render_pass: *u8,
    layout: *u8,
    pipeline: *u8,
    vertex_shader: *u8,
    fragment_shader: *u8,
    cube_vertex: *u8,
    cube_fragment: *u8,
    cube_layout: *u8,
    cube_pipeline: *u8,
    depth_image: *u8,
    depth_memory: *u8,
    depth_view: *u8,
    command_pool: *u8,
    command: *u8,
    image_available: *u8,
    render_finished: *u8,
    acquire: *u8,
    reset_command: *u8,
    begin_command: *u8,
    end_command: *u8,
    begin_pass: *u8,
    end_pass: *u8,
    bind_pipeline: *u8,
    set_viewport: *u8,
    set_scissor: *u8,
    push_constants: *u8,
    draw_cmd: *u8,
    submit: *u8,
    present: *u8,
    queue_wait: *u8,
    device_wait: *u8,
    hwnd: *u8,
    family: u32,
    format: u32,
    depth_format: u32,
    width: u32,
    height: u32,
    // Client size the swapchain was built for. The surface may clamp width and height.
    client_w: u32,
    client_h: u32,
    image_count: u32,
}

fun blank_gpu(library: *u8) -> Gpu {
    return Gpu {
        library: library,
        resources: 0 as *mesh_backend::Context,
        get_instance: null_handle(),
        get_device: null_handle(),
        instance: null_handle(),
        surface: null_handle(),
        physical: null_handle(),
        device: null_handle(),
        queue: null_handle(),
        swapchain: null_handle(),
        view0: null_handle(),
        view1: null_handle(),
        view2: null_handle(),
        view3: null_handle(),
        fb0: null_handle(),
        fb1: null_handle(),
        fb2: null_handle(),
        fb3: null_handle(),
        render_pass: null_handle(),
        layout: null_handle(),
        pipeline: null_handle(),
        vertex_shader: null_handle(),
        fragment_shader: null_handle(),
        cube_vertex: null_handle(),
        cube_fragment: null_handle(),
        cube_layout: null_handle(),
        cube_pipeline: null_handle(),
        depth_image: null_handle(),
        depth_memory: null_handle(),
        depth_view: null_handle(),
        command_pool: null_handle(),
        command: null_handle(),
        image_available: null_handle(),
        render_finished: null_handle(),
        acquire: null_handle(),
        reset_command: null_handle(),
        begin_command: null_handle(),
        end_command: null_handle(),
        begin_pass: null_handle(),
        end_pass: null_handle(),
        bind_pipeline: null_handle(),
        set_viewport: null_handle(),
        set_scissor: null_handle(),
        push_constants: null_handle(),
        draw_cmd: null_handle(),
        submit: null_handle(),
        present: null_handle(),
        queue_wait: null_handle(),
        device_wait: null_handle(),
        hwnd: null_handle(),
        family: 0,
        format: 0,
        depth_format: 0,
        width: 0,
        height: 0,
        client_w: 0,
        client_h: 0,
        image_count: 0,
    }
}

fun drop_gpu(gpu: Gpu) {
    mut wait_fn := gpu.device_wait
    when pointer_is_null(wait_fn) {
        wait_fn = resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::device_wait_name())
    }
    when !pointer_is_null(wait_fn) && !pointer_is_null(gpu.device) {
        wait: VkDeviceWaitFn = wait_fn as VkDeviceWaitFn
        wait(gpu.device)
    }
    mesh_backend::close(gpu.resources)
    destroy_fb := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::destroy_framebuffer_name())
    destroy_view := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::destroy_image_view_name())
    destroy_swap := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::destroy_swapchain_name())
    destroy_pipe := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::destroy_pipeline_name())
    destroy_layout := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::destroy_layout_name())
    destroy_shader := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::destroy_shader_name())
    destroy_pass := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::destroy_render_pass_name())
    destroy_pool := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::destroy_command_pool_name())
    destroy_sem := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::destroy_semaphore_name())
    destroy_child(destroy_fb, gpu.device, gpu.fb0)
    destroy_child(destroy_fb, gpu.device, gpu.fb1)
    destroy_child(destroy_fb, gpu.device, gpu.fb2)
    destroy_child(destroy_fb, gpu.device, gpu.fb3)
    destroy_child(destroy_view, gpu.device, gpu.view0)
    destroy_child(destroy_view, gpu.device, gpu.view1)
    destroy_child(destroy_view, gpu.device, gpu.view2)
    destroy_child(destroy_view, gpu.device, gpu.view3)
    destroy_child(destroy_view, gpu.device, gpu.depth_view)
    destroy_image := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::destroy_image_name())
    free_memory := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::free_memory_name())
    destroy_child(destroy_image, gpu.device, gpu.depth_image)
    destroy_child(free_memory, gpu.device, gpu.depth_memory)
    destroy_child(destroy_swap, gpu.device, gpu.swapchain)
    destroy_child(destroy_pipe, gpu.device, gpu.pipeline)
    destroy_child(destroy_pipe, gpu.device, gpu.cube_pipeline)
    destroy_child(destroy_layout, gpu.device, gpu.layout)
    destroy_child(destroy_layout, gpu.device, gpu.cube_layout)
    destroy_child(destroy_shader, gpu.device, gpu.vertex_shader)
    destroy_child(destroy_shader, gpu.device, gpu.fragment_shader)
    destroy_child(destroy_shader, gpu.device, gpu.cube_vertex)
    destroy_child(destroy_shader, gpu.device, gpu.cube_fragment)
    destroy_child(destroy_pass, gpu.device, gpu.render_pass)
    destroy_child(destroy_pool, gpu.device, gpu.command_pool)
    destroy_child(destroy_sem, gpu.device, gpu.image_available)
    destroy_child(destroy_sem, gpu.device, gpu.render_finished)
    destroy_device := resolve_device_fn(gpu.get_device, gpu.device, gpu.get_instance, gpu.instance, vk_data::destroy_device_name())
    when !pointer_is_null(destroy_device) && !pointer_is_null(gpu.device) {
        destroy: VkDestroyInstanceFn = destroy_device as VkDestroyInstanceFn
        destroy(gpu.device, null_handle())
    }
    when !pointer_is_null(gpu.get_instance) && !pointer_is_null(gpu.instance) {
        destroy_surface := vk_data::resolve(gpu.get_instance, gpu.instance, vk_data::destroy_surface_name())
        destroy_child(destroy_surface, gpu.instance, gpu.surface)
        destroy_instance := vk_data::resolve(gpu.get_instance, gpu.instance, vk_data::destroy_instance_name())
        when !pointer_is_null(destroy_instance) {
            destroy: VkDestroyInstanceFn = destroy_instance as VkDestroyInstanceFn
            destroy(gpu.instance, null_handle())
        }
    }
    when !pointer_is_null(gpu.library) { unload_library(gpu.library) }
}

#[drop(drop_frame)]
pub struct Frame {
    command: *u8,
    resources: *mesh_backend::Context,
    queue: *u8,
    swapchain: *u8,
    image_available: *u8,
    render_finished: *u8,
    layout: *u8,
    end_command: *u8,
    end_pass: *u8,
    submit: *u8,
    present: *u8,
    queue_wait: *u8,
    push_constants: *u8,
    draw_cmd: *u8,
    bind_pipeline: *u8,
    pipeline: *u8,
    cube_pipeline: *u8,
    cube_layout: *u8,
    image_index: u32,
    width: u32,
    height: u32,
}

fun inert_frame() -> Frame {
    return Frame {
        command: null_handle(),
        resources: 0 as *mesh_backend::Context,
        queue: null_handle(),
        swapchain: null_handle(),
        image_available: null_handle(),
        render_finished: null_handle(),
        layout: null_handle(),
        end_command: null_handle(),
        end_pass: null_handle(),
        submit: null_handle(),
        present: null_handle(),
        queue_wait: null_handle(),
        push_constants: null_handle(),
        draw_cmd: null_handle(),
        bind_pipeline: null_handle(),
        pipeline: null_handle(),
        cube_pipeline: null_handle(),
        cube_layout: null_handle(),
        image_index: 0,
        width: 0,
        height: 0,
    }
}

fun drop_frame(frame: Frame) {
    when !pointer_is_null(frame.end_pass) {
        end_pass: VkEndPassFn = frame.end_pass as VkEndPassFn
        end_pass(frame.command)
    }
    when !pointer_is_null(frame.end_command) {
        end_command: VkEndCmdFn = frame.end_command as VkEndCmdFn
        end_command(frame.command)
    }
    submit_present(
        frame.queue,
        frame.command,
        1,
        frame.image_available,
        frame.render_finished,
        frame.swapchain,
        frame.image_index,
        frame.submit,
        frame.present,
        frame.queue_wait
    )
}

extend Gpu {
    pub fun set_ambient_light(self, light: three_d::AmbientLight) {
        when pointer_is_null(self.resources as *u8) { return }
        context := self.resources
        context.ambient_r = channel(light.color.r) context.ambient_g = channel(light.color.g) context.ambient_b = channel(light.color.b)
        context.ambient_intensity = math::scalar_max(light.intensity, 0.0)
    }
    pub fun set_directional_light(self, light: three_d::DirectionalLight) {
        when pointer_is_null(self.resources as *u8) { return }
        direction := light.direction.normalized()
        context := self.resources
        when direction.length_squared() == (0.0 as f32) { context.sun_x = 0.0 context.sun_y = -1.0 context.sun_z = 0.0 context.sun_intensity = 0.0 return }
        context.sun_x = direction.x context.sun_y = direction.y context.sun_z = direction.z
        context.sun_intensity = math::scalar_max(light.intensity, 0.0) context.sun_color = packed_color(light.color)
    }
    // Opens a Vulkan device for this Win32 window. Drawing stays on the frames begin() returns.
    pub fun open(hwnd: *u8) -> Gpu {
        when pointer_is_null(hwnd) { return blank_gpu(null_handle()) }
        library := load_library("vulkan-1.dll")
        when pointer_is_null(library) { return blank_gpu(null_handle()) }
        mut gpu := blank_gpu(library)
        gpu.hwnd = hwnd
        gpu.get_instance = load_symbol(gpu.library, "vkGetInstanceProcAddr")
        when pointer_is_null(gpu.get_instance) { return gpu }
        gpu.instance = make_instance(gpu.get_instance)
        when pointer_is_null(gpu.instance) { return gpu }
        gpu.surface = make_surface(gpu.get_instance, gpu.instance, hwnd)
        when pointer_is_null(gpu.surface) { return gpu }
        chosen := choose_device(gpu.get_instance, gpu.instance, gpu.surface, hwnd)
        when chosen.ok == 0 { return gpu }
        gpu.physical = chosen.physical
        gpu.family = chosen.family
        gpu.format = chosen.format
        gpu.width = chosen.width
        gpu.height = chosen.height
        gpu.device = make_device(gpu.get_instance, gpu.instance, gpu.physical, gpu.family)
        when pointer_is_null(gpu.device) { return gpu }
        gpu.get_device = vk_data::resolve(gpu.get_instance, gpu.instance, vk_data::get_device_proc_name())
        when pointer_is_null(gpu.get_device) { return gpu }
        get_queue := vk_data::resolve(gpu.get_device, gpu.device, vk_data::get_device_queue_name())
        gpu.queue = take_queue(get_queue, gpu.device, gpu.family)
        when pointer_is_null(gpu.queue) { return gpu }
        procs := load_frame_procs(gpu.get_device, gpu.device)
        when !procs_ready(procs) { return gpu }
        gpu.acquire = procs.acquire
        gpu.reset_command = procs.reset_command
        gpu.begin_command = procs.begin_command
        gpu.end_command = procs.end_command
        gpu.begin_pass = procs.begin_pass
        gpu.end_pass = procs.end_pass
        gpu.bind_pipeline = procs.bind_pipeline
        gpu.set_viewport = procs.set_viewport
        gpu.set_scissor = procs.set_scissor
        gpu.push_constants = procs.push_constants
        gpu.draw_cmd = procs.draw_cmd
        gpu.submit = procs.submit
        gpu.present = procs.present
        gpu.queue_wait = procs.queue_wait
        gpu.device_wait = procs.device_wait
        when !gpu.build_chain(chosen) { return gpu }
        create_pass := vk_data::resolve(gpu.get_device, gpu.device, vk_data::create_render_pass_name())
        gpu.render_pass = make_pass(gpu.device, create_pass, gpu.format, gpu.depth_format)
        when pointer_is_null(gpu.render_pass) { return gpu }
        when !gpu.build_framebuffers() { return gpu }
        create_shader := vk_data::resolve(gpu.get_device, gpu.device, vk_data::create_shader_name())
        gpu.vertex_shader = make_vertex_shader(gpu.device, create_shader)
        gpu.fragment_shader = make_fragment_shader(gpu.device, create_shader)
        when pointer_is_null(gpu.vertex_shader) || pointer_is_null(gpu.fragment_shader) { return gpu }
        layout_fn := vk_data::resolve(gpu.get_device, gpu.device, vk_data::create_layout_name())
        pipeline_fn := vk_data::resolve(gpu.get_device, gpu.device, vk_data::create_pipelines_name())
        bundle := make_pipeline(gpu.device, layout_fn, pipeline_fn, gpu.render_pass, gpu.vertex_shader, gpu.fragment_shader, 0, 0, 1, 48, null_handle())
        gpu.layout = bundle.layout
        gpu.pipeline = bundle.pipeline
        when pointer_is_null(gpu.pipeline) || pointer_is_null(gpu.layout) { return gpu }
        gpu.cube_vertex = make_cube_vertex_shader(gpu.device, create_shader)
        gpu.cube_fragment = make_cube_fragment_shader(gpu.device, create_shader)
        when pointer_is_null(gpu.cube_vertex) || pointer_is_null(gpu.cube_fragment) { return gpu }
        gpu.resources = mesh_backend::open(gpu.get_device, gpu.device, gpu.physical, gpu.get_instance, gpu.instance, gpu.queue, gpu.family)
        when pointer_is_null(gpu.resources as *u8) { return gpu }
        cube_bundle := make_pipeline(gpu.device, layout_fn, pipeline_fn, gpu.render_pass, gpu.cube_vertex, gpu.cube_fragment, 1, 1, 1, 128, gpu.resources.set_layout)
        gpu.cube_layout = cube_bundle.layout
        gpu.cube_pipeline = cube_bundle.pipeline
        when pointer_is_null(gpu.cube_pipeline) || pointer_is_null(gpu.cube_layout) { return gpu }
        pool_fn := vk_data::resolve(gpu.get_device, gpu.device, vk_data::create_command_pool_name())
        alloc_fn := vk_data::resolve(gpu.get_device, gpu.device, vk_data::allocate_commands_name())
        pool := make_commands(gpu.device, pool_fn, alloc_fn, gpu.family)
        gpu.command_pool = pool.value
        when pointer_is_null(gpu.command_pool) { return gpu }
        gpu.command = allocate_command(gpu.device, alloc_fn, gpu.command_pool)
        when pointer_is_null(gpu.command) { return gpu }
        sem_fn := vk_data::resolve(gpu.get_device, gpu.device, vk_data::create_semaphore_name())
        gpu.image_available = make_semaphore(gpu.device, sem_fn)
        gpu.render_finished = make_semaphore(gpu.device, sem_fn)
        when pointer_is_null(gpu.image_available) || pointer_is_null(gpu.render_finished) { return gpu }
        return gpu
    }

    // Creates the swapchain, its views, and a matching depth buffer for chosen's extent.
    fun build_chain(mut self, chosen: VkChosen) -> bool {
        client := client_size(self.hwnd)
        self.client_w = client.w
        self.client_h = client.h
        self.width = chosen.width
        self.height = chosen.height
        create_swap := vk_data::resolve(self.get_device, self.device, vk_data::create_swapchain_name())
        images_fn := vk_data::resolve(self.get_device, self.device, vk_data::get_swapchain_images_name())
        view_fn := vk_data::resolve(self.get_device, self.device, vk_data::create_image_view_name())
        chain := make_swapchain(self.device, create_swap, images_fn, view_fn, self.surface, chosen)
        self.swapchain = chain.swapchain
        self.view0 = chain.view0
        self.view1 = chain.view1
        self.view2 = chain.view2
        self.view3 = chain.view3
        self.image_count = chain.count
        when pointer_is_null(self.swapchain) || pointer_is_null(self.view0) || self.image_count == 0 { return false }
        when self.image_count > 1 && pointer_is_null(self.view1) { return false }
        when self.image_count > 2 && pointer_is_null(self.view2) { return false }
        when self.image_count > 3 && pointer_is_null(self.view3) { return false }
        depth := make_depth(self.get_instance, self.instance, self.get_device, self.device, self.physical, self.width, self.height)
        self.depth_image = depth.image
        self.depth_memory = depth.memory
        self.depth_view = depth.view
        when pointer_is_null(self.depth_view) { return false }
        // The render pass was created for the first depth format; another one would not be compatible.
        when self.depth_format != 0 && depth.format != self.depth_format { return false }
        self.depth_format = depth.format
        return true
    }

    fun build_framebuffers(mut self) -> bool {
        create_fb := vk_data::resolve(self.get_device, self.device, vk_data::create_framebuffer_name())
        self.fb0 = make_framebuffer(self.device, create_fb, self.render_pass, self.view0, self.depth_view, self.width, self.height)
        when self.image_count > 1 {
            self.fb1 = make_framebuffer(self.device, create_fb, self.render_pass, self.view1, self.depth_view, self.width, self.height)
        }
        when self.image_count > 2 {
            self.fb2 = make_framebuffer(self.device, create_fb, self.render_pass, self.view2, self.depth_view, self.width, self.height)
        }
        when self.image_count > 3 {
            self.fb3 = make_framebuffer(self.device, create_fb, self.render_pass, self.view3, self.depth_view, self.width, self.height)
        }
        when pointer_is_null(self.fb0) { return false }
        when self.image_count > 1 && pointer_is_null(self.fb1) { return false }
        when self.image_count > 2 && pointer_is_null(self.fb2) { return false }
        when self.image_count > 3 && pointer_is_null(self.fb3) { return false }
        return true
    }

    // Destroys everything that depends on the window size. The render pass and pipelines stay.
    fun release_targets(mut self) {
        when pointer_is_null(self.device) || pointer_is_null(self.get_device) { return }
        when !pointer_is_null(self.device_wait) {
            wait: VkDeviceWaitFn = self.device_wait as VkDeviceWaitFn
            wait(self.device)
        }
        destroy_fb := vk_data::resolve(self.get_device, self.device, vk_data::destroy_framebuffer_name())
        destroy_view := vk_data::resolve(self.get_device, self.device, vk_data::destroy_image_view_name())
        destroy_image := vk_data::resolve(self.get_device, self.device, vk_data::destroy_image_name())
        free_memory := vk_data::resolve(self.get_device, self.device, vk_data::free_memory_name())
        destroy_swap := vk_data::resolve(self.get_device, self.device, vk_data::destroy_swapchain_name())
        destroy_child(destroy_fb, self.device, self.fb0)
        destroy_child(destroy_fb, self.device, self.fb1)
        destroy_child(destroy_fb, self.device, self.fb2)
        destroy_child(destroy_fb, self.device, self.fb3)
        destroy_child(destroy_view, self.device, self.view0)
        destroy_child(destroy_view, self.device, self.view1)
        destroy_child(destroy_view, self.device, self.view2)
        destroy_child(destroy_view, self.device, self.view3)
        destroy_child(destroy_view, self.device, self.depth_view)
        destroy_child(destroy_image, self.device, self.depth_image)
        destroy_child(free_memory, self.device, self.depth_memory)
        destroy_child(destroy_swap, self.device, self.swapchain)
        self.fb0 = null_handle()
        self.fb1 = null_handle()
        self.fb2 = null_handle()
        self.fb3 = null_handle()
        self.view0 = null_handle()
        self.view1 = null_handle()
        self.view2 = null_handle()
        self.view3 = null_handle()
        self.depth_view = null_handle()
        self.depth_image = null_handle()
        self.depth_memory = null_handle()
        self.swapchain = null_handle()
        self.image_count = 0
    }

    // Rebuilds the size-dependent targets for the window's current client area.
    fun rebuild_targets(mut self) -> bool {
        when pointer_is_null(self.render_pass) { return false }
        self.release_targets()
        families_fn := vk_data::resolve(self.get_instance, self.instance, vk_data::queue_families_name())
        support_fn := vk_data::resolve(self.get_instance, self.instance, vk_data::surface_support_name())
        caps_fn := vk_data::resolve(self.get_instance, self.instance, vk_data::surface_caps_name())
        formats_fn := vk_data::resolve(self.get_instance, self.instance, vk_data::surface_formats_name())
        chosen := consider_device(families_fn, support_fn, caps_fn, formats_fn, self.surface, self.hwnd, self.physical)
        when chosen.ok == 0 || chosen.format != self.format || chosen.family != self.family { return false }
        when !self.build_chain(chosen) { return false }
        return self.build_framebuffers()
    }

    // Width of the drawable area in pixels.
    pub fun is_ready(self) -> bool => self.ready()
    pub fun width(self) -> u32 => self.width
    // Height of the drawable area in pixels.
    pub fun height(self) -> u32 => self.height

    fun ready(self) -> bool {
        when pointer_is_null(self.device) || pointer_is_null(self.swapchain) || pointer_is_null(self.command) { return false }
        when pointer_is_null(self.pipeline) || pointer_is_null(self.cube_pipeline) || pointer_is_null(self.cube_layout) { return false }
        when pointer_is_null(self.queue) || pointer_is_null(self.render_pass) || pointer_is_null(self.depth_view) { return false }
        when pointer_is_null(self.image_available) || pointer_is_null(self.render_finished) || pointer_is_null(self.layout) { return false }
        when pointer_is_null(self.acquire) || pointer_is_null(self.reset_command) || pointer_is_null(self.begin_command) { return false }
        when pointer_is_null(self.end_command) || pointer_is_null(self.begin_pass) || pointer_is_null(self.end_pass) { return false }
        when pointer_is_null(self.bind_pipeline) || pointer_is_null(self.set_viewport) || pointer_is_null(self.set_scissor) { return false }
        when pointer_is_null(self.push_constants) || pointer_is_null(self.draw_cmd) || pointer_is_null(self.submit) { return false }
        when pointer_is_null(self.present) || pointer_is_null(self.queue_wait) { return false }
        when self.width == 0 || self.height == 0 || self.image_count == 0 || pointer_is_null(self.fb0) { return false }
        return true
    }

    fun consume_semaphore(self, index: u32) {
        submit_present(
            self.queue,
            self.command,
            0,
            self.image_available,
            self.render_finished,
            self.swapchain,
            index,
            self.submit,
            self.present,
            self.queue_wait
        )
    }

    fun start_pass(self, framebuffer: *u8) -> i32 {
        mut area := VkRect { x: 0, y: 0, w: self.width, h: self.height }
        mut clear := VkClearPair {
            color: VkClear { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
            depth: VkClearDepth { depth: 1.0, stencil: 0, pad0: 0, pad1: 0 },
        }
        mut info := VkPassBegin {
            s_type: 43,
            next: null_handle(),
            pass: self.render_pass,
            framebuffer: framebuffer,
            area: area,
            clear_count: 2,
            clears: (&raw clear) as *u8,
        }
        call: VkBeginPassFn = self.begin_pass as VkBeginPassFn
        call(self.command, &raw mut info, 0)
        return 0
    }

    fun prepare_draw(self) {
        mut viewport := VkViewport {
            x: 0.0,
            y: 0.0,
            w: self.width as f32,
            h: self.height as f32,
            min_z: 0.0,
            max_z: 1.0,
        }
        set_viewport: VkSetViewportFn = self.set_viewport as VkSetViewportFn
        set_viewport(self.command, 0, 1, &raw viewport)
        mut scissor := VkRect { x: 0, y: 0, w: self.width, h: self.height }
        set_scissor: VkSetScissorFn = self.set_scissor as VkSetScissorFn
        set_scissor(self.command, 0, 1, &raw scissor)
        bind: VkBindPipelineFn = self.bind_pipeline as VkBindPipelineFn
        bind(self.command, 0, self.pipeline)
    }

    // Acquires one swapchain image. The returned frame presents that image when it drops.
    // A resized window rebuilds the swapchain first. A minimized window yields a frame that draws nothing.
    pub fun begin(mut self) -> Frame {
        when pointer_is_null(self.device) || pointer_is_null(self.render_pass) { return inert_frame() }
        client := client_size(self.hwnd)
        when client.w == 0 || client.h == 0 { return inert_frame() }
        when pointer_is_null(self.swapchain) || client.w != self.client_w || client.h != self.client_h {
            when !self.rebuild_targets() { return inert_frame() }
        }
        when !self.ready() { return inert_frame() }
        mut index: u32 = 0
        acquire: VkAcquireFn = self.acquire as VkAcquireFn
        result := acquire(self.device, self.swapchain, 1000000000, self.image_available, null_handle(), &raw mut index)
        // VK_ERROR_OUT_OF_DATE_KHR: drop the swapchain so the next begin rebuilds it.
        when result == -1000001004 {
            self.release_targets()
            return inert_frame()
        }
        when result != 0 && result != 1000001003 { return inert_frame() }
        reset: VkResetCmdFn = self.reset_command as VkResetCmdFn
        reset(self.command, 0)
        mut recording: u32 = 0
        mut started: u32 = 0
        begin_command: VkBeginCmdFn = self.begin_command as VkBeginCmdFn
        mut begin_info := VkCommandBegin { s_type: 42, next: null_handle(), flags: 1, inherit: null_handle() }
        when begin_command(self.command, &raw mut begin_info) == (0 as i32) {
            recording = 1
            framebuffer := pick4(index, self.fb0, self.fb1, self.fb2, self.fb3)
            when !pointer_is_null(framebuffer) {
                self.start_pass(framebuffer)
                started = 1
                self.prepare_draw()
            }
        }
        when recording == 0 {
            self.consume_semaphore(index)
            return inert_frame()
        }
        mut end_pass_fn := null_handle()
        when started != 0 { end_pass_fn = self.end_pass }
        return Frame {
            command: self.command,
            resources: self.resources,
            queue: self.queue,
            swapchain: self.swapchain,
            image_available: self.image_available,
            render_finished: self.render_finished,
            layout: self.layout,
            end_command: self.end_command,
            end_pass: end_pass_fn,
            submit: self.submit,
            present: self.present,
            queue_wait: self.queue_wait,
            push_constants: self.push_constants,
            draw_cmd: self.draw_cmd,
            bind_pipeline: self.bind_pipeline,
            pipeline: self.pipeline,
            cube_pipeline: self.cube_pipeline,
            cube_layout: self.cube_layout,
            image_index: index,
            width: self.width,
            height: self.height,
        }
    }
}

extend Frame {
    // Width of this frame in pixels. An inert frame reports 0.
    pub fun width(self) -> u32 => self.width
    // Height of this frame in pixels. An inert frame reports 0.
    pub fun height(self) -> u32 => self.height

    fun draw_shape(self, x: f32, y: f32, w: f32, h: f32, color: Color, radius: f32, mode: f32) {
        when pointer_is_null(self.command) || pointer_is_null(self.push_constants) || pointer_is_null(self.draw_cmd) { return }
        when pointer_is_null(self.layout) || pointer_is_null(self.pipeline) || pointer_is_null(self.bind_pipeline) { return }
        when w <= 0.0 || h <= 0.0 { return }
        shape_bind: VkBindPipelineFn = self.bind_pipeline as VkBindPipelineFn
        shape_bind(self.command, 0, self.pipeline)
        mut push := VkPush {
            ox: x,
            oy: y,
            sx: w,
            sy: h,
            cr: channel(color.r),
            cg: channel(color.g),
            cb: channel(color.b),
            ca: channel(color.a),
            vw: self.width as f32,
            vh: self.height as f32,
            radius: radius,
            mode: mode,
        }
        push_cmd: VkPushCmdFn = self.push_constants as VkPushCmdFn
        push_cmd(self.command, self.layout, 17, 0, 48, (&raw push) as *u8)
        draw: VkDrawFn = self.draw_cmd as VkDrawFn
        draw(self.command, 6, 1, 0, 0)
    }

    pub fun clear(self, color: Color) {
        when self.width == 0 || self.height == 0 { return }
        self.draw_shape(0.0, 0.0, self.width as f32, self.height as f32, color, 0.0, 0.0)
    }

    pub fun fill_rect(self, x: i32, y: i32, width: i32, height: i32, color: Color) {
        when width <= 0 || height <= 0 { return }
        self.draw_shape(x as f32, y as f32, width as f32, height as f32, color, 0.0, 0.0)
    }

    pub fun fill_circle(self, x: i32, y: i32, radius: i32, color: Color) {
        when radius <= 0 { return }
        self.draw_shape(
            (x - radius) as f32,
            (y - radius) as f32,
            (radius * 2) as f32,
            (radius * 2) as f32,
            color,
            radius as f32,
            1.0
        )
    }

    fun draw_geometry(self, source: *assets::MeshData, image_source: *texture::TextureData, camera: three_d::Camera, center: math::Vec3, size: math::Vec3, yaw: f32, material: assets::Material) -> bool {
        when pointer_is_null(self.command) || pointer_is_null(self.resources as *u8) || pointer_is_null(self.cube_pipeline) { return false }
        when self.width == 0 || self.height == 0 || size.x <= 0.0 || size.y <= 0.0 || size.z <= 0.0 { return false }
        geometry := mesh_backend::mesh(self.resources, source)
        image := mesh_backend::image(self.resources, image_source)
        when pointer_is_null(geometry as *u8) || pointer_is_null(image as *u8) { return false }
        model := math::Mat4::translation(center.x, center.y, center.z).mul(math::Mat4::rotation_y(yaw).mul(math::Mat4::scale(size.x, size.y, size.z)))
        context := self.resources
        mut push := MeshPush {
            mvp: camera.view_projection_for(self.width, self.height).mul(model), yaw: yaw, sx: size.x, sy: size.y, sz: size.z,
            sun_x: context.sun_x, sun_y: context.sun_y, sun_z: context.sun_z, sun_intensity: context.sun_intensity,
            ambient_r: context.ambient_r, ambient_g: context.ambient_g, ambient_b: context.ambient_b, ambient_intensity: context.ambient_intensity,
            base_color: packed_color(material.base_color), sun_color: context.sun_color, pad0: 0, pad1: 0,
        }
        bind: VkBindPipelineFn = self.bind_pipeline as VkBindPipelineFn
        bind(self.command, 0, self.cube_pipeline)
        mut vertex := geometry.vertices mut offset: u64 = 0 mut set := image.set
        bind_vertex: MeshBindVertexFn = mesh_backend::proc(context, "vkCmdBindVertexBuffers") as MeshBindVertexFn
        bind_index: MeshBindIndexFn = mesh_backend::proc(context, "vkCmdBindIndexBuffer") as MeshBindIndexFn
        bind_sets: MeshBindSetsFn = mesh_backend::proc(context, "vkCmdBindDescriptorSets") as MeshBindSetsFn
        draw: MeshDrawIndexedFn = mesh_backend::proc(context, "vkCmdDrawIndexed") as MeshDrawIndexedFn
        bind_vertex(self.command, 0, 1, &raw mut vertex, &raw mut offset)
        bind_index(self.command, geometry.indices, 0, 1)
        bind_sets(self.command, 0, self.cube_layout, 0, 1, &raw mut set, 0, 0 as *u8)
        push_cmd: VkPushCmdFn = self.push_constants as VkPushCmdFn
        push_cmd(self.command, self.cube_layout, 17, 0, 128, (&raw push) as *u8)
        draw(self.command, source.index_count, 1, 0, 0, 0)
        return true
    }
    pub fun draw_mesh(self, mesh: &assets::Mesh, camera: three_d::Camera, center: math::Vec3, size: math::Vec3, yaw: f32, material: assets::Material) -> bool {
        when pointer_is_null(self.resources as *u8) { return false }
        return self.draw_geometry(assets::mesh_data(mesh), self.resources.white, camera, center, size, yaw, material)
    }
    pub fun draw_mesh_textured(self, mesh: &assets::Mesh, image: &texture::Texture, camera: three_d::Camera, center: math::Vec3, size: math::Vec3, yaw: f32, material: assets::Material) -> bool {
        return self.draw_geometry(assets::mesh_data(mesh), texture::data(image), camera, center, size, yaw, material)
    }
    pub fun draw_model(self, value: &model::Model, camera: three_d::Camera, center: math::Vec3, size: math::Vec3, yaw: f32) -> bool {
        return self.draw_geometry(model::geometry(value), model::image(value), camera, center, size, yaw, model::material(value))
    }
    pub fun draw_cube(self, camera: three_d::Camera, center: math::Vec3, size: math::Vec3, yaw: f32) {
        self.draw_cube_color(camera, center, size, yaw, math::Color::WHITE)
    }
    pub fun draw_cube_color(self, camera: three_d::Camera, center: math::Vec3, size: math::Vec3, yaw: f32, color: math::Color) -> bool {
        when pointer_is_null(self.resources as *u8) { return false }
        return self.draw_geometry(self.resources.cube, self.resources.white, camera, center, size, yaw, assets::Material::new(color))
    }
    pub fun draw_plane(self, camera: three_d::Camera, center: math::Vec3, size: math::Vec2, color: math::Color) -> bool {
        when pointer_is_null(self.resources as *u8) { return false }
        return self.draw_geometry(self.resources.plane, self.resources.white, camera, center, math::Vec3::new(size.x, 1.0, size.y), 0.0, assets::Material::new(color))
    }
    pub fun draw_sphere(self, camera: three_d::Camera, center: math::Vec3, radius: f32, color: math::Color) -> bool {
        when pointer_is_null(self.resources as *u8) { return false }
        return self.draw_geometry(self.resources.sphere, self.resources.white, camera, center, math::Vec3::new(radius, radius, radius), 0.0, assets::Material::new(color))
    }
}
