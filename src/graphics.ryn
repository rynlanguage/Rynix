type VkCreateDeviceFn = extern "C" fun(*u8, *VkDeviceInfo, *u8, *VkOut) -> i32
type VkGetQueueFn = extern "C" fun(*u8, u32, u32, *VkOut)
type VkCreateSwapchainFn = extern "C" fun(*u8, *VkSwapchainInfo, *u8, *VkOut) -> i32
type VkSwapchainImagesFn = extern "C" fun(*u8, *u8, *u32, *VkHandles4) -> i32
type VkCreateViewFn = extern "C" fun(*u8, *VkImageViewInfo, *u8, *VkOut) -> i32
type VkCreatePassFn = extern "C" fun(*u8, *VkPassInfo, *u8, *VkOut) -> i32
type VkCreateFbFn = extern "C" fun(*u8, *VkFramebufferInfo, *u8, *VkOut) -> i32
type VkCreateShaderFn = extern "C" fun(*u8, *VkShaderInfo, *u8, *VkOut) -> i32
type VkCreateLayoutFn = extern "C" fun(*u8, *VkLayoutInfo, *u8, *VkOut) -> i32
type VkCreatePipelinesFn = extern "C" fun(*u8, *u8, u32, *VkPipelineInfo, *u8, *VkOut) -> i32
type VkCreatePoolFn = extern "C" fun(*u8, *VkPoolInfo, *u8, *VkOut) -> i32
type VkAllocCmdFn = extern "C" fun(*u8, *VkCommandAlloc, *VkOut) -> i32
type VkResetCmdFn = extern "C" fun(*u8, u32) -> i32
type VkBeginCmdFn = extern "C" fun(*u8, *VkCommandBegin) -> i32
type VkEndCmdFn = extern "C" fun(*u8) -> i32
type VkBeginPassFn = extern "C" fun(*u8, *VkPassBegin, u32)
type VkEndPassFn = extern "C" fun(*u8)
type VkBindPipelineFn = extern "C" fun(*u8, u32, *u8)
type VkSetViewportFn = extern "C" fun(*u8, u32, u32, *VkViewport)
type VkSetScissorFn = extern "C" fun(*u8, u32, u32, *VkRect)
type VkPushCmdFn = extern "C" fun(*u8, *u8, u32, u32, u32, *u8)
type VkDrawFn = extern "C" fun(*u8, u32, u32, u32, u32)
type VkCreateSemFn = extern "C" fun(*u8, *VkSemaphoreInfo, *u8, *VkOut) -> i32
type VkAcquireFn = extern "C" fun(*u8, *u8, u64, *u8, *u8, *u32) -> i32
type VkSubmitFn = extern "C" fun(*u8, u32, *VkSubmitInfo, *u8) -> i32
type VkPresentFn = extern "C" fun(*u8, *VkPresentInfo) -> i32
