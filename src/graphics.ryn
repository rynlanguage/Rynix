// Immediate drawing. Vulkan handles stay inside this module.
// The first Gpu field is the loader DLL, so a failed open still releases whatever was created.
use rynix::math
use rynix::three_d
use rynix::vk_data
use rynix::assets
use rynix::texture
use rynix::mesh_backend
use rynix::mesh_vertex
use rynix::mesh_fragment
use rynix::model
#[repr(C)]
struct MeshPush { mvp: math::Mat4, yaw: f32, sx: f32, sy: f32, sz: f32, sun_x: f32, sun_y: f32, sun_z: f32, sun_intensity: f32, ambient_r: f32, ambient_g: f32, ambient_b: f32, ambient_intensity: f32, base_color: u32, sun_color: u32, pad0: u32, pad1: u32 }
type MeshBindVertexFn = extern "C" fun(*u8, u32, u32, **u8, *u64)
type MeshBindIndexFn = extern "C" fun(*u8, *u8, u64, u32)
type MeshDrawIndexedFn = extern "C" fun(*u8, u32, u32, u32, i32, u32)
type MeshBindSetsFn = extern "C" fun(*u8, u32, *u8, u32, u32, **u8, u32, *u8)
fun packed_color(color: math::Color) -> u32 => (color.r as u32) | ((color.g as u32) << 8) | ((color.b as u32) << 16) | ((color.a as u32) << 24)

// Public facade constructors; CPU storage and Vulkan interop keep separate ownership.
namespace graphics;
pub type Mesh = assets::Mesh
pub type Vertex = assets::Vertex
pub type Material = assets::Material
pub type Texture = texture::Texture
pub type Model = model::Model
namespace;
extend Mesh {
    pub fun new(vertices: &[assets::Vertex], indices: &[u32]) -> assets::Mesh => assets::Mesh::new(vertices, indices)
    pub fun cube() -> assets::Mesh => assets::Mesh::cube()
    pub fun plane() -> assets::Mesh => assets::Mesh::plane()
    pub fun sphere(segments: u32, rings: u32) -> assets::Mesh => assets::Mesh::sphere(segments, rings)
}
extend Vertex {
    pub fun new(position: math::Vec3, normal: math::Vec3, uv: math::Vec2) -> assets::Vertex => assets::Vertex::new(position, normal, uv)
}
extend Material {
    pub fun new(color: math::Color) -> assets::Material => assets::Material::new(color)
}
extend Texture {
    pub fun load(path: str) -> texture::Texture => texture::Texture::load(path)
    pub fun white() -> texture::Texture => texture::Texture::white()
}
extend Model {
    pub fun load(path: str) -> model::Model => model::Model::load(path)
}

