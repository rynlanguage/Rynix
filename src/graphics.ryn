type VkQueueFamiliesFn = extern "C" fun(*u8, *u32, *VkFamilyList)
type VkCreateSurfaceFn = extern "C" fun(*u8, *VkWin32Surface, *u8, *VkOut) -> i32
type VkDestroyChildFn = extern "C" fun(*u8, *u8, *u8)
