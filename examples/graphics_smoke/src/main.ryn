// Renders a few frames, resizes the window, and checks that frames follow the new size.
// Exit code 0 means the swapchain was rebuilt. 20 means no Vulkan frame could be drawn at all.
use rynix::graphics
use rynix::math
use rynix::three_d
use rynix::window

fun main() -> i32 {
    mut window := window::Window::open(640, 480, "Rynix graphics smoke")
    when !window.is_open() { return 1 }
    mut gpu := graphics::Gpu::open(window.native_handle())
    camera := three_d::Camera::new(math::Vec3::new(2.0, 2.0, 3.0), math::Vec3::ZERO, math::Vec3::UP, 45.0)

    mut frames: u32 = 0
    mut first_w: u32 = 0
    mut first_h: u32 = 0
    while frames < 3 && window.poll_events() {
        frame := gpu.begin()
        first_w = frame.width()
        first_h = frame.height()
        frame.clear(math::Color::DARK_GRAY)
        frame.draw_cube(camera, math::Vec3::ZERO, math::Vec3::ONE, 0.5)
        frame.fill_rect(10, 10, 100, 20, math::Color::ORANGE)
        frames += 1
    }
    when first_w == (0 as u32) { return 20 }
    when first_w != (640 as u32) || first_h != (480 as u32) { return 2 }

    when !window.set_size(800, 600) { return 3 }
    mut resized_w: u32 = 0
    mut resized_h: u32 = 0
    frames = 0
    while frames < 3 && window.poll_events() {
        frame := gpu.begin()
        resized_w = frame.width()
        resized_h = frame.height()
        frame.clear(math::Color::SKY_BLUE)
        frame.draw_cube(camera, math::Vec3::ZERO, math::Vec3::ONE, 1.0)
        frame.fill_circle(400, 300, 40, math::Color::PURPLE)
        frames += 1
    }
    when resized_w != (800 as u32) || resized_h != (600 as u32) { return 4 }
    when gpu.width() != (800 as u32) || gpu.height() != (600 as u32) { return 5 }
    window.close()
    echo "graphics smoke passed"
    return 0
}
