use rynix::math
use rynix::three_d
use rynix::assets
fun close(a: f32, b: f32) -> bool => a - b < (0.0001 as f32) && b - a < (0.0001 as f32)
fun vector(a: math::Vec3, b: math::Vec3) -> bool => close(a.x, b.x) && close(a.y, b.y) && close(a.z, b.z)
fun distance(value: Option<f32>, expected: f32) -> bool => choose value { Option::Some(t) => close(t, expected), Option::None => false }
fun main() -> i32 {
    mut camera := three_d::FpsCamera::new(math::Vec3::ZERO)
    when !vector(camera.forward(), math::Vec3::new(0.0, 0.0, -1.0)) || !vector(camera.right(), math::Vec3::new(1.0, 0.0, 0.0)) { return 1 }
    camera.set_angles(90.0, 0.0)
    when !vector(camera.forward(), math::Vec3::new(1.0, 0.0, 0.0)) || !vector(camera.right(), math::Vec3::new(0.0, 0.0, 1.0)) { return 2 }
    camera.move_local(1.0, 0.0, 0.0, false, 0.2)
    when !vector(camera.position(), math::Vec3::new(1.0, 0.0, 0.0)) { return 3 }
    camera.move_local(1.0, 0.0, 0.0, true, 0.2)
    when !vector(camera.position(), math::Vec3::new(3.0, 0.0, 0.0)) { return 4 }
    camera.set_angles(0.0, 150.0) when !close(camera.pitch, 89.0) { return 5 }
    camera.look_by(100.0, 100000.0) when !close(camera.yaw, 12.0) || !close(camera.pitch, -89.0) { return 6 }
    mut a := three_d::FpsCamera::new(math::Vec3::ZERO) mut b := three_d::FpsCamera::new(math::Vec3::ZERO)
    a.move_local(1.0, 1.0, 0.0, false, 1.0)
    mut i: u32 = 0 while i < 100 { b.move_local(1.0, 1.0, 0.0, false, 0.01) i += 1 }
    when !vector(a.position(), b.position()) || !close(a.position().length(), 5.0) { return 7 }
    origin := b.position() b.move_local(1.0, 0.0, 0.0, false, -1.0) when !vector(origin, b.position()) { return 8 }
    mut low := camera.camera() low.aspect = 2.0 low.near_plane = 0.5 low.far_plane = 40.0
    p := low.projection_matrix()
    when !close(p.c0 / (0.0 - p.c5), 0.5) || !close((p.c10 * (-0.5 as f32) + p.c14) / (0.5 as f32), 0.0) || !close((p.c10 * (-40.0 as f32) + p.c14) / (40.0 as f32), 1.0) { return 9 }
    when !close(math::Mat4::perspective(60.0, 0.0, 0.1, 10.0).c0, 1.0) { return 10 }
    box := three_d::Aabb::new(math::Vec3::new(-1.0, -1.0, -1.0), math::Vec3::ONE)
    when !box.contains(math::Vec3::ZERO) || !box.contains(math::Vec3::ONE) || box.contains(math::Vec3::new(2.0, 0.0, 0.0)) { return 11 }
    touching := three_d::Aabb::new(math::Vec3::ONE, math::Vec3::new(2.0, 2.0, 2.0))
    invalid := three_d::Aabb::new(math::Vec3::ONE, math::Vec3::ZERO)
    when !box.intersects(touching) || invalid.intersects(box) { return 12 }
    sphere := three_d::SphereCollider::new(math::Vec3::ZERO, 1.0)
    when !sphere.contains(math::Vec3::UP) || !sphere.intersects(three_d::SphereCollider::new(math::Vec3::new(2.0, 0.0, 0.0), 1.0)) || sphere.intersects(three_d::SphereCollider::new(math::Vec3::new(3.0, 0.0, 0.0), 1.0)) { return 13 }
    when three_d::SphereCollider::new(math::Vec3::ZERO, -1.0).contains(math::Vec3::ZERO) { return 14 }
    ray := three_d::Ray::new(math::Vec3::new(0.0, 0.0, 5.0), math::Vec3::new(0.0, 0.0, -4.0))
    when !distance(ray.intersect_aabb(box), 4.0) || !distance(ray.intersect_plane(math::Vec3::ZERO, math::Vec3::new(0.0, 0.0, 1.0)), 5.0) { return 15 }
    when three_d::Ray::new(math::Vec3::ZERO, math::Vec3::ZERO).intersect_aabb(box).is_some() { return 16 }
    when !distance(three_d::Ray::new(math::Vec3::ZERO, math::Vec3::UP).intersect_aabb(box), 0.0) { return 17 }
    when three_d::Ray::new(math::Vec3::new(3.0, 0.0, 0.0), math::Vec3::UP).intersect_aabb(box).is_some() || ray.intersect_aabb(invalid).is_some() { return 18 }
    when ray.intersect_plane(math::Vec3::new(0.0, 0.0, 6.0), math::Vec3::new(0.0, 0.0, 1.0)).is_some() || ray.intersect_plane(math::Vec3::ZERO, math::Vec3::UP).is_some() { return 19 }
    // Every nondegenerate triangle must point in the direction of its supplied normal.
    mesh := assets::Mesh::sphere(16, 8)
    i = 0
    while i < mesh.index_count() {
        va := mesh.vertex(mesh.index(i)) vb := mesh.vertex(mesh.index(i + 1)) vc := mesh.vertex(mesh.index(i + 2))
        pa := math::Vec3::new(va.x, va.y, va.z) pb := math::Vec3::new(vb.x, vb.y, vb.z) pc := math::Vec3::new(vc.x, vc.y, vc.z)
        cross := pb.sub(pa).cross(pc.sub(pa))
        when cross.length_squared() > (0.000001 as f32) && cross.dot(pa) <= (0.0 as f32) { return 20 }
        i += 3
    }
    echo "camera / projection / ray / collision / winding checks passed"
    return 0
}
