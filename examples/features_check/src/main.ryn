// GPU-free regression for procedural helpers, bitmap text metrics and tone generation.
// Exit code 0 means every check passed; each failing check returns its own number.
use rynix::math
use rynix::procgen
use rynix::text
use rynix::audio
use rynix::three_d
use rynix::spirv
use rynix::shaders
use rynix::graphics

fun near(a: f32, b: f32) -> bool => a - b < (0.0001 as f32) && b - a < (0.0001 as f32)

fun word(module: spirv::Module, index: u64) -> u32 {
    source := (module.data as u64 + index * 4) as *u32
    return *source
}

// Structural check of a SPIR-V module: magic number, instruction lengths that tile the whole
// module, and a bound that covers every id. It does not check types or semantics.
fun well_formed(module: spirv::Module) -> bool {
    count := module.bytes / 4
    when count < 6 || word(module, 0) != 119734787 { return false }
    bound := word(module, 3)
    mut i: u64 = 5
    while i < count {
        header := word(module, i)
        length := (header >> (16 as u32)) as u64
        when length == 0 || i + length > count { return false }
        // Result ids are the second word of most instructions; each must be below the bound.
        i += length
    }
    return i == count && bound > 1
}

fun main() -> i32 {
    // Same seed, same sequence; a different seed differs.
    mut first := procgen::Random::new(42)
    mut second := procgen::Random::new(42)
    mut other := procgen::Random::new(43)
    mut same := true
    mut differs := false
    mut i: i32 = 0
    while i < 16 {
        a := first.next_u32()
        when a != second.next_u32() { same = false }
        when a != other.next_u32() { differs = true }
        i += 1
    }
    when !same || !differs { return 1 }
    // Ranges stay inside their bounds.
    mut rng := procgen::Random::new(7)
    mut j: i32 = 0
    while j < 200 {
        unit := rng.next_unit()
        when unit < 0.0 || unit >= 1.0 { return 2 }
        picked := rng.range_i32(3, 7)
        when picked < 3 || picked >= 7 { return 3 }
        value := rng.range(-2.0, 2.0)
        when value < -2.0 || value > 2.0 { return 4 }
        j += 1
    }
    when rng.range_i32(5, 5) != 5 || rng.range_i32(9, 2) != 9 { return 5 }
    // Lattice hash is stable and in [0, 1]; integer coordinates of value noise hit the lattice exactly.
    when !near(procgen::lattice(3, 4, 99), procgen::lattice(3, 4, 99)) { return 6 }
    when !near(procgen::value_noise(3.0, 4.0, 99), procgen::lattice(3, 4, 99)) { return 7 }
    mut y: i32 = 0
    while y < 32 {
        mut x: i32 = 0
        while x < 32 {
            sample := procgen::fractal_noise(0.25 * (x as f32), 0.25 * (y as f32), 4, 1234)
            when sample < 0.0 || sample > 1.0 { return 8 }
            x += 1
        }
        y += 1
    }
    // Terrain heights are bounded by the configured height and repeat for the same input.
    terrain := procgen::Terrain::new(2024, 16.0, 10.0)
    mut k: i32 = 0
    while k < 100 {
        h := terrain.height_at((k as f32) * 1.5 - 40.0, (k as f32) * -0.75)
        when h < 0.0 || h > 10.0 { return 9 }
        when !near(h, terrain.height_at((k as f32) * 1.5 - 40.0, (k as f32) * -0.75)) { return 10 }
        k += 1
    }
    // Text metrics: advance includes one spacing column, and the last glyph has none.
    when text::width("", 2) != 0 || text::width("AB", 1) != 11 || text::width("ABC", 3) != 51 { return 11 }
    when text::glyph_width() != 5 || text::glyph_height() != 7 || text::advance() != 6 { return 12 }
    // Glyph lookup: lowercase uses the capital shape; out-of-range codes use the box.
    when text::glyph_index('A') != 33 || text::glyph_index(' ') != 0 { return 13 }
    when text::glyph_index('~') != 94 || text::glyph_index('\u{1F600}') != 95 { return 14 }
    font := text::rows()
    mut r: u64 = 0
    while r < 7 {
        when font[33 * 7 + r] != font[text::glyph_index('a') * 7 + r] { return 15 }
        r += 1
    }
    when font[33 * 7] != 0x0E || font[33 * 7 + 3] != 0x1F || font[95 * 7] != 0x1F { return 16 }
    // Tones: exact length, silence at the start, peak bounded by volume, and clamped volume.
    tone := audio::Sound::tone(440.0, 0.1, 0.5)
    when tone.sample_count() != 4410 || tone.rate() != 44100 { return 17 }
    when tone.sample(0) != 0 { return 18 }
    mut peak: i32 = 0
    mut n: u64 = 0
    while n < tone.sample_count() {
        v := tone.sample(n) as i32
        magnitude := when v < 0 { 0 - v } else { v }
        when magnitude > peak { peak = magnitude }
        n += 1
    }
    when peak <= 0 || peak > 16000 { return 19 }
    loud := audio::Sound::tone(440.0, 0.01, 5.0)
    when loud.sample_count() != 441 { return 20 }
    quiet := audio::Sound::silence(0.5)
    when quiet.sample_count() != 22050 { return 21 }
    empty := audio::Sound::tone(0.0, 1.0, 1.0)
    when empty.sample_count() != 0 { return 22 }
    // Generated shaders: both modules are well formed, and the push block matches the shader layout.
    vertex := shaders::mesh_vertex()
    when !well_formed(vertex) { return 27 }
    spirv::release_module(vertex)
    fragment := shaders::mesh_fragment()
    when !well_formed(fragment) { return 28 }
    spirv::release_module(fragment)
    when graphics::mesh_push_size() != 224 { return 29 }
    // Fog: clear before start, full at end, linear between; an end at start is a hard edge.
    fog := three_d::Fog::linear(math::Color::rgb(0, 0, 0), 10.0, 20.0)
    when !near(fog.factor(5.0), 0.0) || !near(fog.factor(15.0), 0.5) || !near(fog.factor(25.0), 1.0) { return 23 }
    hard := three_d::Fog::linear(math::Color::rgb(0, 0, 0), 5.0, 5.0)
    when hard.factor(4.0) != 0.0 || hard.factor(6.0) != 1.0 || three_d::Fog::off().enabled { return 24 }
    // Point light: full intensity at its position, falling linearly, nothing at or past the radius.
    origin := math::Vec3::new(1.0, 2.0, 3.0)
    lamp := three_d::PointLight::new(origin, math::Color::rgb(255, 255, 255), 2.0, 4.0)
    when !near(lamp.strength_at(origin), 2.0) || !near(lamp.strength_at(math::Vec3::new(3.0, 2.0, 3.0)), 1.0) { return 25 }
    when lamp.strength_at(math::Vec3::new(5.0, 2.0, 3.0)) != 0.0 || three_d::PointLight::off().strength_at(origin) != 0.0 { return 26 }
    return 0
}
